<div class="mx-auto max-w-lg px-4 py-12">
  <h1 class="text-2xl font-bold">Nueva contraseña</h1>
  <%= form_for(resource, as: resource_name, url: password_path(resource_name), html: { method: :put, class: "mt-6 space-y-4" }) do |f| %>
    <%= f.hidden_field :reset_password_token %>
    <div>
      <%= f.label :password, class: "block text-sm font-medium" %>
      <%= f.password_field :password, autofocus: true, class: "input-field" %>
    </div>
    <div>
      <%= f.label :password_confirmation, class: "block text-sm font-medium" %>
      <%= f.password_field :password_confirmation, class: "input-field" %>
    </div>
    <%= f.submit "Cambiar contraseña", class: "btn-primary w-full" %>
  <% end %>
</div>
