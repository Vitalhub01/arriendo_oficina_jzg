<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold">Recuperar contraseña</h1>
    <p class="mt-1 text-sm text-gray-600">
      Solicitudes desde el login. Genera el enlace de restablecimiento desde el usuario y compártelo por WhatsApp.
    </p>
  </div>
  <% if @pending_count.positive? %>
    <span class="rounded-full bg-amber-100 px-3 py-1 text-sm font-medium text-amber-900">
      <%= @pending_count %> pendiente<%= @pending_count == 1 ? '' : 's' %>
    </span>
  <% end %>
</div>

<div class="mt-4 flex flex-wrap gap-2 text-sm">
  <%= link_to "Todas", admin_password_reset_requests_path, class: "text-brand hover:underline" %>
  <%= link_to "Pendientes", admin_password_reset_requests_path(status: :pending), class: "text-brand hover:underline" %>
  <%= link_to "Atendidas", admin_password_reset_requests_path(status: :resolved), class: "text-brand hover:underline" %>
</div>

<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Correo</th>
        <th>Usuario</th>
        <th>Solicitud</th>
        <th>Estado</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% if @password_reset_requests.empty? %>
        <tr>
          <td colspan="5" class="py-8 text-center text-sm text-gray-500">No hay solicitudes.</td>
        </tr>
      <% end %>
      <% @password_reset_requests.each do |req| %>
        <tr>
          <td class="font-medium text-gray-900"><%= req.email %></td>
          <td>
            <% if req.user %>
              <%= link_to req.user.name, edit_admin_user_path(req.user), class: "text-brand hover:underline" %>
            <% else %>
              <span class="text-gray-500">Sin cuenta registrada</span>
            <% end %>
          </td>
          <td><%= l(req.created_at, format: :short) %></td>
          <td>
            <% if req.pending? %>
              <span class="font-medium text-amber-800">Pendiente</span>
            <% else %>
              <span class="text-gray-600">
                Atendida <%= l(req.resolved_at, format: :short) if req.resolved_at %>
                <% if req.resolved_by %>
                  <span class="text-gray-500">por <%= req.resolved_by.name %></span>
                <% end %>
              </span>
            <% end %>
          </td>
          <td class="admin-table__actions">
            <% if req.user %>
              <%= link_to "Enlace de restablecimiento", password_reset_link_admin_user_path(req.user), class: "text-brand hover:underline" %>
            <% end %>
            <% if req.pending? %>
              <%= button_to "Marcar atendida",
                            admin_password_reset_request_path(req),
                            method: :patch,
                            params: { resolve: true },
                            form: { class: "inline" },
                            class: "ml-3 text-sm text-gray-700 hover:underline" %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
<%== pagy_nav(@pagy) if @pagy.pages > 1 %>
