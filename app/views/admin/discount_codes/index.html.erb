<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold">Códigos de descuento</h1>
    <p class="mt-1 text-sm text-gray-600">Los clientes los aplican en la reserva antes de pagar con Mercado Pago.</p>
  </div>
  <%= link_to "Nuevo código", new_admin_discount_code_path, class: "btn-primary" %>
</div>

<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Código</th>
        <th>Descuento</th>
        <th>Tipos de reserva</th>
        <th>Restricciones</th>
        <th>Vigencia</th>
        <th>Usos / cupo</th>
        <th>Confirmadas</th>
        <th>Estado</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @discount_codes.each do |code| %>
        <tr>
          <td class="font-mono font-medium text-gray-900"><%= code.code %></td>
          <td><%= code.display_discount %></td>
          <td class="text-sm text-gray-700"><%= code.display_booking_types %></td>
          <td class="text-sm text-gray-600">
            <% restrictions = code.display_schedule_restrictions(space_titles_by_id: @space_titles_by_id) %>
            <% if restrictions.present? %>
              <%= restrictions %>
            <% else %>
              <span class="text-gray-400">—</span>
            <% end %>
            <% if code.max_uses_per_user.present? %>
              <div class="text-xs text-gray-500">Máx. <%= code.max_uses_per_user %> por usuario</div>
            <% end %>
          </td>
          <td>
            <%= l(code.starts_at.to_date) %> —
            <%= l(code.ends_at.to_date) %>
          </td>
          <td>
            <%= code.redemptions_count %>
            <% if code.max_uses.present? %>
              / <%= code.max_uses %>
            <% end %>
            <% if code.max_uses_per_user.present? %>
              <div class="text-xs text-gray-500"><%= code.max_uses_per_user %> / usuario</div>
            <% end %>
          </td>
          <td class="font-medium text-gray-900">
            <%= @confirmed_bookings_counts[code.id] || 0 %>
          </td>
          <td>
            <% if code.redeemable_at? %>
              <span class="text-green-700">Vigente</span>
            <% elsif code.active? %>
              <span class="text-amber-700">Fuera de vigencia o sin cupos</span>
            <% else %>
              <span class="text-gray-500">Inactivo</span>
            <% end %>
          </td>
          <td class="admin-table__actions">
            <%= link_to "Editar", edit_admin_discount_code_path(code), class: "text-brand hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
