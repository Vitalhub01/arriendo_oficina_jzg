<h1 class="text-2xl font-bold">Reserva #<%= @booking.id %></h1>
<div class="card mt-6 p-6 text-sm">
  <p><strong>Espacio:</strong> <%= @booking.space.title %></p>
  <p><strong>Profesional:</strong> <%= @booking.profesional.name %> (<%= @booking.profesional.email %>)</p>
  <p><strong>Fecha:</strong> <%= l(@booking.start_at, format: :long) %></p>
  <p><strong>Total:</strong> <%= @booking.formatted_total %></p>
  <p><strong>Estado:</strong> <%= booking_status_label(@booking) %></p>
</div>
