<div class="max-w-4xl">
  <%= link_to "← Reservas", admin_bookings_path, class: "text-sm text-brand hover:underline" %>
  <h1 class="mt-2 text-2xl font-bold">Nueva reserva</h1>
  <p class="mt-1 text-sm text-gray-600">Asigna espacio, franja horaria y profesional. Usa el calendario como en la reserva pública.</p>

  <% if flash.now[:alert].present? %>
    <div class="mt-4 rounded-lg bg-red-50 p-3 text-sm text-red-800"><%= flash.now[:alert] %></div>
  <% end %>

  <%= form_with scope: :booking,
        url: admin_bookings_path,
        class: "mt-6 space-y-4",
        data: {
          controller: "admin-booking-form",
          admin_booking_form_schedule_url_value: schedule_admin_bookings_path
        } do |f| %>
    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= f.label :profesional_id, "Profesional", class: "block text-sm font-medium" %>
        <%= f.collection_select :profesional_id,
              @professionals,
              :id,
              :name,
              { prompt: "Seleccionar…", selected: params.dig(:booking, :profesional_id) },
              class: "input-field mt-1 w-full",
              required: true %>
      </div>

      <div>
        <%= f.label :space_id, "Espacio", class: "block text-sm font-medium" %>
        <%= f.collection_select :space_id,
              @spaces,
              :id,
              :title,
              { prompt: "Seleccionar…", selected: params.dig(:booking, :space_id) },
              class: "input-field mt-1 w-full",
              required: true,
              data: { action: "change->admin-booking-form#spaceChanged" } %>
      </div>
    </div>

    <%= render "admin/bookings/schedule_frame",
          selected_space: @selected_space,
          week_start: @week_start,
          schedule_payload: @availability_schedule_payload,
          booking_params: @booking_form_params %>

    <div class="flex items-start gap-2 rounded-lg border border-gray-200 bg-gray-50 p-3">
      <%= f.check_box :confirm_manually,
            { checked: params.dig(:booking, :confirm_manually).nil? || params.dig(:booking, :confirm_manually) == "1" },
            "1",
            "0" %>
      <div>
        <%= f.label :confirm_manually, "Confirmar manualmente (sin pago en línea)", class: "text-sm font-medium" %>
        <p class="text-xs text-gray-600">La reserva quedará como confirmada manualmente. Desmarca para dejarla pendiente de pago.</p>
      </div>
    </div>

    <div class="flex flex-wrap gap-2 pt-2">
      <%= f.submit "Crear reserva", class: "btn-primary" %>
      <%= link_to "Cancelar", admin_bookings_path, class: "btn-secondary" %>
    </div>
  <% end %>
</div>
