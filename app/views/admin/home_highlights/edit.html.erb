<h1 class="text-2xl font-bold">Editar destacado</h1>
<%= form_with model: @home_highlight, url: admin_home_highlight_path(@home_highlight), method: :patch, class: "mt-6 max-w-3xl space-y-4" do |f| %>
  <%= render "form", f: f, home_highlight: @home_highlight %>
<% end %>
<div class="mt-4">
  <%= button_to "Eliminar", admin_home_highlight_path(@home_highlight), method: :delete, class: "text-sm text-red-600 hover:underline", form: { data: { turbo_confirm: "¿Eliminar este destacado?" } } %>
</div>
