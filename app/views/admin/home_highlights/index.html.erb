<h1 class="text-2xl font-bold">Destacados del inicio</h1>
<p class="mt-2 max-w-2xl text-sm text-gray-600">
  Bloques con ícono bajo el hero de la página principal (por ejemplo «Flexibilidad», «Luminosidad»).
  Al editar puedes elegir entre <%= HomeHighlightIcons.keys.size %> íconos con significado (reloj, sol, mapa, WiFi, etc.).
  En la descripción puedes usar <code class="rounded bg-gray-100 px-1">{ciudad}</code> para mostrar la ciudad de la oficina.
</p>
<%= link_to "Nuevo destacado", new_admin_home_highlight_path, class: "btn-primary mt-4 inline-flex" %>
<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Ícono</th>
        <th>Título</th>
        <th>Descripción</th>
        <th>Orden</th>
        <th>Visible</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @home_highlights.each do |highlight| %>
        <tr>
          <td>
            <span class="inline-flex h-9 w-9 items-center justify-center rounded-full bg-brand-pale text-brand">
              <%= render "shared/home_highlight_icon", icon_key: highlight.icon_key, css_class: "h-5 w-5" %>
            </span>
          </td>
          <td class="font-medium text-gray-900"><%= highlight.title %></td>
          <td class="text-gray-600"><%= highlight.description %></td>
          <td><%= highlight.position %></td>
          <td><%= highlight.visible? ? 'Sí' : 'No' %></td>
          <td class="admin-table__actions">
            <%= link_to "Editar", edit_admin_home_highlight_path(highlight), class: "text-brand hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
