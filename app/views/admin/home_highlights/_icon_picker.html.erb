<fieldset class="space-y-3">
  <legend class="block text-sm font-medium text-gray-900">Ícono</legend>
  <p class="text-xs text-gray-500">Haz clic en una tarjeta para elegir el ícono. Se muestra en la franja bajo el hero del inicio.</p>
  <div class="grid max-h-[28rem] grid-cols-2 gap-2 overflow-y-auto rounded-lg border border-gray-200 bg-gray-50 p-3 sm:grid-cols-3" role="radiogroup" aria-label="Ícono del destacado">
    <% HomeHighlightIcons::DEFINITIONS.each do |key, meta| %>
      <label class="group relative block cursor-pointer">
        <%= form.radio_button :icon_key, key, class: "absolute inset-0 z-10 h-full w-full cursor-pointer opacity-0" %>
        <span class="pointer-events-none flex flex-col items-center gap-2 rounded-lg border border-gray-200 bg-white p-3 text-center transition hover:border-brand-light group-has-[:checked]:border-brand group-has-[:checked]:ring-2 group-has-[:checked]:ring-brand/30">
          <span class="flex h-10 w-10 items-center justify-center rounded-full bg-brand-pale text-brand">
            <%= render "shared/home_highlight_icon", icon_key: key, css_class: "h-5 w-5" %>
          </span>
          <span class="text-xs font-medium text-gray-900"><%= meta[:label] %></span>
          <span class="text-[11px] leading-snug text-gray-500"><%= meta[:hint] %></span>
        </span>
      </label>
    <% end %>
  </div>
</fieldset>
