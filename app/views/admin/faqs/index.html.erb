<h1 class="text-2xl font-bold">FAQ</h1>
<%= link_to "Nueva pregunta", new_admin_faq_path, class: "btn-primary mt-4 inline-flex" %>
<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Pregunta</th>
        <th>Visible</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @faqs.each do |faq| %>
        <tr>
          <td class="font-medium text-gray-900"><%= faq.question %></td>
          <td><%= faq.visible? ? 'Sí' : 'No' %></td>
          <td class="admin-table__actions">
            <%= link_to "Editar", edit_admin_faq_path(faq), class: "text-brand hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
