<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Jornadas</h1>
  <%= link_to "Nueva jornada", new_admin_jornada_definition_path, class: "btn-primary" %>
</div>
<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Horario</th>
        <th>Precio</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @jornada_definitions.each do |j| %>
        <tr>
          <td class="font-medium text-gray-900"><%= j.name %></td>
          <td><%= j.start_time.strftime('%H:%M') %> - <%= j.end_time.strftime('%H:%M') %></td>
          <td><%= j.formatted_price %></td>
          <td class="admin-table__actions">
            <%= link_to "Editar", edit_admin_jornada_definition_path(j), class: "text-brand hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
