<h1 class="text-2xl font-bold">Profesionales</h1>
<div class="mt-4 flex gap-2">
  <%= link_to "Todos", admin_professionals_path, class: "text-sm text-rose-600" %>
  <%= link_to "Pendientes", admin_professionals_path(validation_status: :pending), class: "text-sm text-rose-600" %>
</div>
<table class="mt-6 w-full text-sm">
  <thead><tr class="border-b"><th class="py-2 text-left">Nombre</th><th>RUT</th><th>Estado</th><th></th></tr></thead>
  <tbody>
    <% @professional_profiles.each do |p| %>
      <tr class="border-b">
        <td class="py-2"><%= p.user.name %></td>
        <td><%= p.full_rut %></td>
        <td><%= p.validation_status %></td>
        <td><%= link_to "Ver", admin_professional_path(p), class: "text-rose-600" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
<%== pagy_nav(@pagy) if @pagy.pages > 1 %>
