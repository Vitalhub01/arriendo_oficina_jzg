<%= form_with model: social_contact, url: url, method: method, class: "mt-6 max-w-xl space-y-4" do |f| %>
  <% if social_contact.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc pl-5">
        <% social_contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.label :name, "Nombre de la red", class: "block text-sm font-medium" %>
  <%= f.text_field :name, class: "input-field", placeholder: "Instagram" %>

  <%= f.label :username, "Usuario (opcional)", class: "block text-sm font-medium" %>
  <%= f.text_field :username, class: "input-field", placeholder: "vitalhub" %>

  <%= f.label :url, "Enlace", class: "block text-sm font-medium" %>
  <%= f.url_field :url, class: "input-field", placeholder: "https://instagram.com/vitalhub" %>

  <%= f.label :icon, "Ícono PNG", class: "block text-sm font-medium" %>
  <% if social_contact.icon.attached? %>
    <div class="mb-2">
      <%= image_tag social_contact.icon, alt: social_contact.name, class: "h-10 w-10 object-contain" %>
      <p class="mt-1 text-xs text-gray-500">Sube otro archivo para reemplazar el ícono actual.</p>
    </div>
  <% end %>
  <%= f.file_field :icon, accept: "image/png", class: "input-field" %>

  <%= f.label :position, "Orden", class: "block text-sm font-medium" %>
  <%= f.number_field :position, min: 0, class: "input-field" %>

  <%= f.label :visible, class: "inline-flex items-center gap-2 text-sm font-medium" do %>
    <%= f.check_box :visible %>
    Visible en el sitio
  <% end %>

  <%= f.submit "Guardar", class: "btn-primary" %>
<% end %>
