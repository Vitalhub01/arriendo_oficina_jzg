<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Planes de membresía</h1>
  <%= link_to "Nuevo plan", new_admin_membership_plan_path, class: "btn-primary" %>
</div>
<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Precio</th>
        <th>Activo</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @membership_plans.each do |plan| %>
        <tr>
          <td class="font-medium text-gray-900"><%= plan.name %></td>
          <td><%= plan.formatted_price %></td>
          <td><%= plan.active? ? 'Sí' : 'No' %></td>
          <td class="admin-table__actions">
            <%= link_to "Editar", edit_admin_membership_plan_path(plan), class: "text-brand hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
