<h1 class="text-2xl font-bold">Testimonios</h1>
<%= link_to "Agregar testimonio", new_admin_testimonial_path, class: "btn-primary mt-4 inline-flex" %>
<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Autor</th>
        <th>Visible</th>
        <th>Texto</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @testimonials.each do |t| %>
        <tr>
          <td class="font-medium text-gray-900"><%= t.display_author || '—' %></td>
          <td><%= t.visible? ? 'Sí' : 'No' %></td>
          <td class="max-w-xs truncate"><%= t.body %></td>
          <td class="admin-table__actions">
            <%= link_to "Editar", edit_admin_testimonial_path(t), class: "text-brand text-xs hover:underline" %>
            <%= button_to "Eliminar", admin_testimonial_path(t), method: :delete, form: { data: { turbo_confirm: "¿Eliminar este testimonio?" } }, class: "text-red-600 text-xs hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
