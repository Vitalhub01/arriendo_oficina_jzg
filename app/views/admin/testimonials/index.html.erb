<h1 class="text-2xl font-bold">Testimonios</h1>
<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Profesional</th>
        <th>Visible</th>
        <th>Texto</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @testimonials.each do |t| %>
        <tr>
          <td class="font-medium text-gray-900"><%= t.profesional.name %></td>
          <td><%= t.visible? ? 'Sí' : 'No' %></td>
          <td class="max-w-xs truncate"><%= t.body %></td>
          <td class="admin-table__actions">
            <%= button_to t.visible? ? "Ocultar" : "Mostrar", admin_testimonial_path(t), method: :patch, params: { testimonial: { visible: !t.visible? } }, class: "text-brand text-xs hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
