<h1 class="text-2xl font-bold"><%= @pricing_rule.persisted? ? 'Editar regla' : 'Nueva regla' %></h1>
<%= form_with model: @pricing_rule, url: @pricing_rule.persisted? ? admin_pricing_rule_path(@pricing_rule) : admin_pricing_rules_path, class: "mt-6 max-w-xl space-y-4" do |f| %>
  <%= f.label :name, class: "block text-sm font-medium" %>
  <%= f.text_field :name, class: "input-field" %>
  <%= f.hidden_field :rule_type, value: "membership_discount" %>
  <%= f.label :priority, class: "block text-sm font-medium" %>
  <%= f.number_field :priority, class: "input-field" %>
  <%= label_tag "pricing_rule[config][discount_percent]", "Descuento membresía %", class: "block text-sm font-medium" %>
  <%= number_field_tag "pricing_rule[config][discount_percent]", @pricing_rule.config['discount_percent'], class: "input-field" %>
  <%= f.label :active, class: "inline-flex items-center gap-2" %>
  <%= f.check_box :active %>
  <%= f.submit "Guardar", class: "btn-primary" %>
<% end %>
