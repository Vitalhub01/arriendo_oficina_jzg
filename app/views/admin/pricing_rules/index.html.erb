<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Descuentos de membresía (global)</h1>
  <p class="mt-1 text-sm text-gray-600">Los precios por franja y descuentos por volumen se configuran en el calendario de cada espacio.</p>
  <%= link_to "Nueva regla", new_admin_pricing_rule_path, class: "btn-primary" %>
</div>
<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Tipo</th>
        <th>Activa</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @pricing_rules.each do |rule| %>
        <tr>
          <td class="font-medium text-gray-900"><%= rule.name %></td>
          <td><%= rule.rule_type %></td>
          <td><%= rule.active? ? 'Sí' : 'No' %></td>
          <td class="admin-table__actions">
            <%= link_to "Editar", edit_admin_pricing_rule_path(rule), class: "text-brand hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
