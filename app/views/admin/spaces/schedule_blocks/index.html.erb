<% calendar_start_hour = 7 %>
<% calendar_end_hour = 23 %>
<% calendar_minutes = (calendar_end_hour - calendar_start_hour) * 60 %>
<% week_dates = (0..6).map { |i| @week_start + i.days } %>
<% blocks_json = @schedule_blocks.map { |b|
  {
    id: b.id,
    day_of_week: b.day_of_week,
    start_time: b.start_time.strftime('%H:%M'),
    end_time: b.end_time.strftime('%H:%M'),
    price_cents: b.price_cents,
    price_clp: b.price_cents,
    name: b.name,
    duration_minutes: b.duration_minutes
  }
}.to_json %>
<% overrides_json = @overrides.values.map { |o|
  {
    schedule_block_id: o.schedule_block_id,
    date: o.date.iso8601,
    blocked: o.blocked,
    price_cents: o.price_cents,
    price_clp: o.price_cents,
    start_time: o.start_time&.strftime('%H:%M'),
    end_time: o.end_time&.strftime('%H:%M')
  }
}.to_json %>

<div data-controller="admin-schedule"
     data-admin-schedule-blocks-value="<%= blocks_json %>"
     data-admin-schedule-overrides-value="<%= overrides_json %>"
     data-admin-schedule-week-dates-value="<%= week_dates.map(&:iso8601).to_json %>"
     data-admin-schedule-space-id-value="<%= @space.id %>"
     data-admin-schedule-week-start-value="<%= @week_start.iso8601 %>"
     data-admin-schedule-default-price-value="<%= @space.default_price_per_slot_cents %>"
     data-admin-schedule-slot-duration-value="<%= @space.slot_duration_minutes %>"
     data-admin-schedule-csrf-value="<%= form_authenticity_token %>"
     data-admin-schedule-calendar-start-value="<%= calendar_start_hour %>"
     data-admin-schedule-calendar-end-value="<%= calendar_end_hour %>">

  <div class="flex flex-wrap items-center justify-between gap-4">
    <div>
      <h1 class="text-2xl font-bold">Calendario y precios — <%= @space.title %></h1>
      <p class="mt-1 text-sm text-gray-600">Usa el lápiz para editar o el basurero para quitar un horario (solo ese día o toda la plantilla).</p>
    </div>
    <%= link_to "← Espacios", admin_spaces_path, class: "text-sm text-brand hover:underline" %>
  </div>

  <div id="schedule-toast" class="<%= params[:saved] == '1' ? '' : 'hidden' %> mt-4 rounded-xl bg-green-50 p-3 text-green-800" role="status" data-admin-schedule-target="toast">
    Cambios guardados
  </div>

  <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="btn-primary text-sm" data-action="admin-schedule#openNew">
        Agregar horario
      </button>
      <button type="button" class="btn-secondary text-sm" data-action="admin-schedule#openBulkFill">
        Rellenar por rango
      </button>
    </div>
    <div class="flex items-center gap-2 text-sm">
      <%= link_to "← Semana", admin_space_schedule_blocks_path(@space, week_start: @week_start - 1.week), class: "text-brand hover:underline" %>
      <span class="text-gray-600"><%= l(@week_start, format: :short) %> – <%= l(@week_start + 6.days, format: :short) %></span>
      <%= link_to "Semana →", admin_space_schedule_blocks_path(@space, week_start: @week_start + 1.week), class: "text-brand hover:underline" %>
    </div>
  </div>

  <div class="mt-6 overflow-x-auto rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="grid min-w-[960px] grid-cols-[3rem_repeat(7,1fr)]">
      <div class="border-b border-r border-gray-100 bg-gray-50"></div>
      <% week_dates.each_with_index do |date, day| %>
        <div class="border-b border-r border-gray-100 bg-gray-50 py-2 text-center">
          <p class="text-xs font-semibold text-gray-800"><%= AvailabilityRule::DAY_NAMES[day][0..2] %></p>
          <p class="text-[10px] text-gray-500"><%= l(date, format: '%d/%m') %></p>
        </div>
      <% end %>

      <div class="relative border-r border-gray-100 bg-gray-50/50" style="height: <%= calendar_minutes %>px;">
        <% (calendar_start_hour...calendar_end_hour).each do |h| %>
          <div class="absolute right-1 text-[10px] text-gray-400" style="top: <%= (h - calendar_start_hour) * 60 %>px;"><%= sprintf('%02d:00', h) %></div>
        <% end %>
      </div>

      <% week_dates.each_with_index do |date, day| %>
        <div class="relative border-r border-gray-100 bg-white"
             style="height: <%= calendar_minutes %>px;"
             data-day="<%= day %>"
             data-date="<%= date.iso8601 %>">
          <% @schedule_blocks.select { |b| b.day_of_week == day }.each do |block| %>
            <% next unless block.active_on?(date) %>
            <% override = @overrides[[block.id, date]] %>
            <% blocked = override&.blocked? %>
            <% eff_start = override&.start_time || block.start_time %>
            <% eff_end = override&.end_time || block.end_time %>
            <% start_m = eff_start.hour * 60 + eff_start.min %>
            <% end_m = eff_end.hour * 60 + eff_end.min %>
            <% top = ((start_m - calendar_start_hour * 60).to_f / calendar_minutes * 100) %>
            <% height = ((end_m - start_m).to_f / calendar_minutes * 100) %>
            <% price_label = blocked ? 'Bloqueado' : (override&.price_cents ? block.formatted_price_on(date) : block.formatted_price) %>
            <div role="button" tabindex="0"
                 class="absolute left-0.5 right-0.5 cursor-pointer overflow-hidden rounded-md border text-left text-[10px] leading-tight transition hover:ring-2 hover:ring-brand/40 <%= blocked ? 'border-red-200 bg-red-50 text-red-800' : 'border-brand/30 bg-brand/10 text-gray-900 hover:bg-brand/20' %> <%= 'ring-2 ring-amber-300' if !blocked && (override&.price_cents.present? || override&.start_time.present?) %>"
                 style="top: <%= top %>%; height: <%= [height, 3].max %>%; min-height: 28px;"
                 data-action="click->admin-schedule#openEdit keydown->admin-schedule#openEditKey"
                 data-block-id="<%= block.id %>"
                 data-date="<%= date.iso8601 %>">
              <div class="pointer-events-none absolute top-0 right-0 z-10 flex items-center gap-0.5 px-0.5 py-0.5">
                <span class="rounded p-0.5 text-gray-500" title="Editar" aria-hidden="true">
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M16.862 4.487l1.687-1.688a1.875 1.875 0 112.652 2.652L10.582 16.07a4.5 4.5 0 01-1.897 1.13L6 18l.8-2.685a4.5 4.5 0 011.13-1.897l8.932-8.931z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 7.125L16.862 4.487"/></svg>
                </span>
                <button type="button"
                        class="pointer-events-auto rounded p-0.5 text-gray-500 hover:bg-red-50 hover:text-red-600"
                        title="Eliminar"
                        aria-label="Eliminar horario"
                        data-action="click->admin-schedule#promptDelete"
                        data-block-id="<%= block.id %>"
                        data-date="<%= date.iso8601 %>">
                  <svg class="h-3 w-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"/></svg>
                </button>
              </div>
              <div class="px-1 pb-0.5 pr-9 pt-0.5 <%= 'line-through' if blocked %>">
                <span class="font-semibold"><%= eff_start.strftime('%H:%M') %>–<%= eff_end.strftime('%H:%M') %></span>
                <span class="block truncate"><%= price_label %></span>
                <% unless blocked %>
                  <span class="block text-gray-500"><%= block.duration_minutes %> min</span>
                <% end %>
              </div>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <p class="mt-2 text-xs text-gray-500">Borde ámbar = precio especial ese día · Tachado rojo = bloqueado solo esa fecha</p>

  <div class="mt-8 card p-4">
    <h2 class="font-semibold">Descuento por volumen (esta sala)</h2>
    <p class="mt-1 text-sm text-gray-600">Se aplica al reservar varios bloques contiguos en una sola reserva.</p>
    <% if @volume_rules.any? %>
      <ul class="mt-4 space-y-3">
        <% @volume_rules.each do |rule| %>
          <li class="rounded-lg bg-gray-50 p-3">
            <%= form_with model: rule, url: admin_space_volume_pricing_rule_path(@space, rule), method: :patch, class: "grid gap-3 md:grid-cols-4" do |f| %>
              <%= f.text_field :name, class: "input-field", placeholder: "Nombre" %>
              <%= number_field_tag "pricing_rule[config][min_slots]", rule.config['min_slots'], class: "input-field", placeholder: "Mín. bloques" %>
              <%= number_field_tag "pricing_rule[config][discount_percent]", rule.config['discount_percent'], class: "input-field", placeholder: "% descuento" %>
              <div class="flex items-center gap-2">
                <%= f.check_box :active %>
                <%= f.submit "Guardar", class: "btn-primary text-sm" %>
                <%= button_to "Eliminar", admin_space_volume_pricing_rule_path(@space, rule), method: :delete, class: "text-sm text-red-600", form: { data: { turbo_confirm: "¿Eliminar?" } } %>
              </div>
            <% end %>
          </li>
        <% end %>
      </ul>
    <% end %>
    <%= form_with model: @volume_rule, url: admin_space_volume_pricing_rules_path(@space), class: "mt-4 grid gap-3 md:grid-cols-4" do |f| %>
      <%= f.text_field :name, class: "input-field", placeholder: "Nombre", value: "Descuento por volumen" %>
      <%= number_field_tag "pricing_rule[config][min_slots]", 4, class: "input-field", placeholder: "Mín. bloques" %>
      <%= number_field_tag "pricing_rule[config][discount_percent]", 10, class: "input-field", placeholder: "% descuento" %>
      <%= f.submit "Agregar descuento", class: "btn-primary text-sm" %>
    <% end %>
  </div>

  <dialog data-admin-schedule-target="dialog" class="fixed inset-0 z-50 m-auto w-[min(100%,32rem)] max-h-[90vh] rounded-xl border-0 bg-white p-0 shadow-xl backdrop:bg-black/50 open:flex open:flex-col">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-lg font-semibold" data-admin-schedule-target="dialogTitle">Horario</h2>
      <p class="mt-1 text-sm text-gray-500" data-admin-schedule-target="dialogSubtitle"></p>
    </div>

    <div class="border-b border-gray-200 bg-gray-100 px-4 pt-2" data-admin-schedule-target="tabBar">
      <div class="flex gap-0.5" role="tablist">
        <button type="button" role="tab" id="schedule-tab-date" aria-controls="schedule-panel-date"
                data-admin-schedule-target="tabDate"
                data-action="admin-schedule#selectTab"
                data-tab="date"
                class="hidden rounded-t-lg border border-b-0 border-transparent px-4 py-2 text-sm font-medium text-gray-600 transition hover:bg-gray-200/80">
          Solo esta fecha
        </button>
        <button type="button" role="tab" id="schedule-tab-template" aria-controls="schedule-panel-template"
                data-admin-schedule-target="tabTemplate"
                data-action="admin-schedule#selectTab"
                data-tab="template"
                class="rounded-t-lg border border-b-0 border-transparent bg-white px-4 py-2 text-sm font-medium text-gray-900 shadow-sm">
          Plantilla semanal
        </button>
      </div>
    </div>

    <div class="max-h-[70vh] overflow-y-auto bg-white px-6 py-4">
      <section id="schedule-panel-date" role="tabpanel" aria-labelledby="schedule-tab-date"
               data-admin-schedule-target="panelDate"
               class="hidden">
        <p class="text-xs text-gray-600">Cambios solo para el día seleccionado en el calendario.</p>
        <input type="hidden" data-admin-schedule-target="occurrenceDate" value="">
        <div class="mt-4 grid grid-cols-2 gap-3">
          <div>
            <label class="block text-sm font-medium">Inicio (solo este día)</label>
            <input type="time" data-admin-schedule-target="dateStartTime" class="input-field mt-1 w-full">
          </div>
          <div>
            <label class="block text-sm font-medium">Fin (solo este día)</label>
            <input type="time" data-admin-schedule-target="dateEndTime" class="input-field mt-1 w-full">
          </div>
        </div>
        <p class="mt-1 text-xs text-gray-500" data-admin-schedule-target="dateTimeHint"></p>
        <div class="mt-4">
          <label class="block text-sm font-medium">Precio especial (CLP)</label>
          <input type="number" data-admin-schedule-target="datePriceClp" class="input-field mt-1 w-full" min="1" step="1" placeholder="Opcional — deja vacío para usar plantilla">
        </div>
        <div class="mt-4 flex flex-wrap gap-2">
          <button type="button" class="btn-primary text-sm" data-action="admin-schedule#saveDateOverride">Guardar cambios del día</button>
          <button type="button" class="btn-secondary text-sm" data-action="admin-schedule#blockDate">Bloquear este horario</button>
          <button type="button" class="text-sm text-gray-600 hover:underline" data-action="admin-schedule#clearDateOverride">Restaurar plantilla</button>
        </div>
        <p class="mt-3 text-xs text-gray-500" data-admin-schedule-target="dateStatus"></p>
      </section>

      <section id="schedule-panel-template" role="tabpanel" aria-labelledby="schedule-tab-template"
               data-admin-schedule-target="panelTemplate">
        <p class="text-xs text-gray-600">Se repite cada semana en este día y horario.</p>
        <form data-admin-schedule-target="form" class="mt-4 space-y-3" data-action="submit->admin-schedule#save">
          <input type="hidden" data-admin-schedule-target="blockId" value="">
          <input type="hidden" data-admin-schedule-target="dayOfWeek" value="">
          <div data-admin-schedule-target="newDayField" class="hidden">
            <label class="block text-sm font-medium">Día de la semana</label>
            <select data-admin-schedule-target="newDay" data-action="change->admin-schedule#syncNewDay" class="input-field mt-1 w-full">
              <% AvailabilityRule::DAY_NAMES.each_with_index do |name, day| %>
                <option value="<%= day %>"><%= name %></option>
              <% end %>
            </select>
          </div>
          <div>
            <label class="block text-sm font-medium">Nombre (opcional)</label>
            <input type="text" data-admin-schedule-target="name" class="input-field w-full">
          </div>
          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium">Inicio</label>
              <input type="time" data-admin-schedule-target="startTime" class="input-field w-full" required>
            </div>
            <div>
              <label class="block text-sm font-medium">Fin</label>
              <input type="time" data-admin-schedule-target="endTime" class="input-field w-full" required>
            </div>
          </div>
          <div>
            <label class="block text-sm font-medium">Precio del bloque (mañana / tarde, CLP)</label>
            <input type="number" data-admin-schedule-target="priceClp" class="input-field w-full" min="1" step="1" required>
            <p class="mt-1 text-xs text-gray-500">Independiente del precio por hora y de la jornada completa del espacio.</p>
          </div>
          <p class="text-xs text-gray-500" data-admin-schedule-target="durationHint"></p>
          <div class="flex flex-wrap gap-2 pt-1">
            <button type="submit" class="btn-primary">Guardar plantilla</button>
            <button type="button" class="btn-secondary" data-action="admin-schedule#closeDialog">Cerrar</button>
          </div>
        </form>
      </section>
    </div>

    <p class="px-6 pb-4 text-sm text-red-600 hidden" data-admin-schedule-target="error"></p>
  </dialog>

  <dialog data-admin-schedule-target="bulkFillDialog" class="fixed inset-0 z-50 m-auto w-[min(100%,32rem)] max-h-[90vh] rounded-xl border-0 bg-white p-0 shadow-xl backdrop:bg-black/50 open:flex open:flex-col">
    <div class="border-b border-gray-100 px-6 py-4">
      <h2 class="text-lg font-semibold">Rellenar plantilla por rango</h2>
      <p class="mt-1 text-sm text-gray-500">
        Crea bloques de <%= @space.slot_duration_minutes %> min en los días y horario que elijas (por ejemplo, lunes a viernes de 08:00 a 22:00).
      </p>
    </div>
    <form class="max-h-[70vh] overflow-y-auto px-6 py-4" data-action="submit->admin-schedule#saveBulkFill">
      <fieldset>
        <legend class="text-sm font-medium text-gray-900">Días</legend>
        <div class="mt-2 flex flex-wrap gap-3">
          <% AvailabilityRule::DAY_NAMES.each_with_index do |name, day| %>
            <label class="inline-flex items-center gap-1.5 text-sm">
              <input type="checkbox" name="bulk_days" value="<%= day %>"
                     class="rounded border-gray-300"
                     data-admin-schedule-target="bulkDay"
                     <%= 'checked' if day < 5 %>>
              <span><%= name %></span>
            </label>
          <% end %>
        </div>
      </fieldset>
      <div class="mt-4 grid grid-cols-2 gap-3">
        <div>
          <label class="block text-sm font-medium">Desde</label>
          <input type="time" data-admin-schedule-target="bulkStartTime" class="input-field mt-1 w-full" value="08:00" required>
        </div>
        <div>
          <label class="block text-sm font-medium">Hasta</label>
          <input type="time" data-admin-schedule-target="bulkEndTime" class="input-field mt-1 w-full" value="22:00" required>
        </div>
      </div>
      <div class="mt-4">
        <label class="block text-sm font-medium">Precio por bloque (CLP)</label>
        <input type="number" data-admin-schedule-target="bulkPriceClp" class="input-field mt-1 w-full" min="1" step="1"
               value="<%= @space.default_price_per_slot_cents %>" required>
        <p class="mt-1 text-xs text-gray-500">Mismo precio para todos los bloques generados en este rango.</p>
      </div>
      <label class="mt-4 flex items-start gap-2 text-sm">
        <input type="checkbox" data-admin-schedule-target="bulkReplace" class="mt-1 rounded border-gray-300" checked>
        <span>Reemplazar horarios existentes que se solapen con este rango en los días marcados</span>
      </label>
      <p class="mt-4 text-xs text-gray-500" data-admin-schedule-target="bulkPreview"></p>
      <div class="mt-6 flex flex-wrap gap-2">
        <button type="submit" class="btn-primary">Generar bloques</button>
        <button type="button" class="btn-secondary" data-action="admin-schedule#closeBulkFill">Cancelar</button>
      </div>
    </form>
    <p class="px-6 pb-4 text-sm text-red-600 hidden" data-admin-schedule-target="bulkError"></p>
  </dialog>

  <dialog data-admin-schedule-target="deleteDialog" class="fixed inset-0 z-[60] m-auto w-[min(100%,24rem)] rounded-xl border-0 bg-white p-0 shadow-xl backdrop:bg-black/50 open:block">
    <div class="px-6 py-5">
      <h2 class="text-lg font-semibold text-gray-900">Eliminar horario</h2>
      <p class="mt-2 text-sm text-gray-600" data-admin-schedule-target="deleteDialogMessage"></p>
      <div class="mt-6 flex flex-col gap-2">
        <button type="button" class="btn-primary w-full text-sm" data-action="admin-schedule#confirmDeleteOnlyDate">
          Solo esta fecha
        </button>
        <button type="button" class="btn-secondary w-full text-sm" data-action="admin-schedule#confirmDeleteFromDateForward">
          Esta fecha y todas las siguientes
        </button>
        <button type="button" class="mt-1 w-full text-sm text-gray-600 hover:underline" data-action="admin-schedule#closeDeleteDialog">
          Cancelar
        </button>
      </div>
    </div>
  </dialog>
</div>
