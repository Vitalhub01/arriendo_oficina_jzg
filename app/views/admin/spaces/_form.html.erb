<% if @space.errors.any? %>
  <div class="mb-4 rounded-xl bg-red-50 p-4 text-red-800">
    <p class="font-medium">No se pudo guardar:</p>
    <ul class="mt-2 list-disc pl-5 text-sm">
      <% @space.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: @space, url: @space.persisted? ? admin_space_path(@space) : admin_spaces_path, class: "mt-6 max-w-2xl space-y-4" do |f| %>
  <% if @space.persisted? %>
    <%= f.hidden_field :address %>
    <%= f.hidden_field :commune %>
    <%= f.hidden_field :city %>
    <%= f.hidden_field :latitude %>
    <%= f.hidden_field :longitude %>
  <% end %>
  <%= f.label :title, class: "block text-sm font-medium" %>
  <%= f.text_field :title, class: "input-field" %>
  <%= f.label :description, class: "block text-sm font-medium" %>
  <%= f.text_area :description, rows: 4, class: "input-field" %>
  <%= f.label :office_id, "Oficina", class: "block text-sm font-medium" %>
  <%= f.collection_select :office_id, Office.all, :id, :name, {}, class: "input-field" %>
  <%= render "admin/spaces/pricing_fields", space: @space %>
  <% if @space.persisted? %>
    <p class="text-xs text-gray-600">
      <%= link_to "Calendario y excepciones de precio", admin_space_schedule_blocks_path(@space), class: "text-brand hover:underline" %>
    </p>
  <% end %>
  <%= f.label :slot_duration_minutes, "Duración de cada hora en agenda (minutos)", class: "block text-sm font-medium" %>
  <%= f.number_field :slot_duration_minutes, class: "input-field", step: 30, min: 30 %>
  <p class="text-xs text-gray-500">Múltiplo de 30. Ej: 60 = 1 hora por unidad al reservar varias horas seguidas.</p>
  <%= f.label :minimum_slots, "Mínimo de horas por reserva", class: "block text-sm font-medium" %>
  <%= f.number_field :minimum_slots, class: "input-field", min: 1 %>
  <%= f.label :reschedule_notice_hours, "Anticipación para reprogramar (horas)", class: "block text-sm font-medium" %>
  <%= f.number_field :reschedule_notice_hours, class: "input-field", min: 1, step: 1, placeholder: "Vacío = valor global del sitio" %>
  <p class="text-xs text-gray-500">El profesional puede reprogramar hasta esta cantidad de horas antes del inicio de la cita.</p>
  <%= f.label :capacity, class: "block text-sm font-medium" %>
  <%= f.number_field :capacity, class: "input-field" %>
  <%= f.label :dimensions, class: "block text-sm font-medium" %>
  <%= f.text_field :dimensions, class: "input-field" %>
  <%= f.label :status, class: "block text-sm font-medium" %>
  <%= f.select :status, Space.statuses.keys, {}, class: "input-field" %>
  <%= f.label :photos, class: "block text-sm font-medium" %>
  <%= f.file_field :photos, multiple: true, class: "input-field" %>
  <%= f.label :terms_and_conditions, "Términos y condiciones (PDF)", class: "block text-sm font-medium" %>
  <% if @space.terms_and_conditions.attached? %>
    <p class="text-sm text-gray-600">
      Archivo actual:
      <%= link_to @space.terms_and_conditions.filename, rails_blob_path(@space.terms_and_conditions, disposition: "inline"), class: "text-brand hover:underline", target: "_blank", rel: "noopener" %>
    </p>
  <% end %>
  <%= f.file_field :terms_and_conditions, accept: "application/pdf", class: "input-field" %>
  <p class="text-xs text-gray-500">Un PDF por espacio. Los profesionales deberán aceptarlo al reservar.</p>
  <%= f.submit "Guardar", class: "btn-primary" %>
<% end %>
