<div class="mx-auto max-w-4xl">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Espacios</h1>
    <%= link_to "Nuevo espacio", new_admin_space_path, class: "btn-primary" %>
  </div>

  <div class="card mt-6 overflow-hidden">
    <table class="w-full text-sm">
      <thead>
        <tr class="border-b bg-gray-50 text-left text-gray-700">
          <th class="px-4 py-3 font-semibold">Nombre</th>
          <th class="px-4 py-3 font-semibold">Precio/hora</th>
          <th class="px-4 py-3 font-semibold">Estado</th>
          <th class="px-4 py-3 font-semibold text-right">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @spaces.each do |space| %>
          <tr class="border-b last:border-b-0 hover:bg-gray-50/80">
            <td class="px-4 py-3 font-medium text-gray-900"><%= space.title %></td>
            <td class="px-4 py-3 text-gray-700"><%= format_clp(space.price_per_hour_cents) %></td>
            <td class="px-4 py-3 text-gray-600"><%= space.status %></td>
            <td class="px-4 py-3 text-right whitespace-nowrap">
              <%= link_to "Editar", edit_admin_space_path(space), class: "text-brand hover:underline" %>
              <span class="text-gray-300">·</span>
              <%= link_to "Calendario", admin_space_schedule_blocks_path(space), class: "text-brand hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
