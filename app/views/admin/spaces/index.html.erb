<div class="mx-auto max-w-4xl">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Espacios</h1>
    <%= link_to "Nuevo espacio", new_admin_space_path, class: "btn-primary" %>
  </div>

  <div
    class="mt-6"
    data-controller="sortable-list"
    data-sortable-list-reorder-url-value="<%= reorder_admin_spaces_path %>"
    data-sortable-list-csrf-token-value="<%= form_authenticity_token %>"
    data-action="dragover->sortable-list#dragOver drop->sortable-list#dropOnList"
  >
    <p class="mb-4 text-sm text-gray-600">
      Arrastra las filas para definir el orden en el catálogo público y en los destacados del inicio.
      <span data-sortable-list-target="status" class="ml-1 text-brand"></span>
    </p>
    <div class="admin-table-card">
    <table class="admin-table">
      <thead>
        <tr>
          <th class="w-10" aria-label="Orden"></th>
          <th class="w-16">Foto</th>
          <th>Nombre</th>
          <th>Precio/hora</th>
          <th>Estado</th>
          <th class="admin-table__actions">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @spaces.each do |space| %>
          <tr
            class="hover:bg-gray-50/80"
            data-sortable-list-target="row"
            data-sortable-id="<%= space.id %>"
          >
            <td class="text-gray-400">
              <button
                type="button"
                class="cursor-grab px-1 py-2 active:cursor-grabbing"
                title="Arrastrar para reordenar"
                draggable="true"
                data-action="dragstart->sortable-list#dragStart dragend->sortable-list#dragEnd"
              >
                ⋮⋮
              </button>
            </td>
            <td>
              <% if space.cover_photo %>
                <%= image_tag space.cover_photo.variant(resize_to_limit: [96, 72]), class: "h-12 w-16 rounded object-cover bg-gray-100", alt: space.title %>
              <% else %>
                <span class="flex h-12 w-16 items-center justify-center rounded bg-gray-100 text-xs text-gray-400">Sin foto</span>
              <% end %>
            </td>
            <td class="font-medium text-gray-900"><%= space.title %></td>
            <td><%= format_clp(space.price_per_hour_cents) %></td>
            <td><%= space.status %></td>
            <td class="admin-table__actions">
              <%= link_to "Editar", edit_admin_space_path(space), class: "text-brand hover:underline" %>
              <span class="text-gray-300">·</span>
              <%= link_to "Calendario", admin_space_schedule_blocks_path(space), class: "text-brand hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
    </div>
  </div>
</div>
