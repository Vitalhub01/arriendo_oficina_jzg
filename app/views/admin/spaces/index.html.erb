<div class="mx-auto max-w-4xl">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-bold">Espacios</h1>
    <%= link_to "Nuevo espacio", new_admin_space_path, class: "btn-primary" %>
  </div>

  <div class="admin-table-card mt-6">
    <table class="admin-table">
      <thead>
        <tr>
          <th>Nombre</th>
          <th>Precio/hora</th>
          <th>Estado</th>
          <th class="admin-table__actions">Acciones</th>
        </tr>
      </thead>
      <tbody>
        <% @spaces.each do |space| %>
          <tr class="hover:bg-gray-50/80">
            <td class="font-medium text-gray-900"><%= space.title %></td>
            <td><%= format_clp(space.price_per_hour_cents) %></td>
            <td><%= space.status %></td>
            <td class="admin-table__actions">
              <%= link_to "Editar", edit_admin_space_path(space), class: "text-brand hover:underline" %>
              <span class="text-gray-300">·</span>
              <%= link_to "Calendario", admin_space_schedule_blocks_path(space), class: "text-brand hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
</div>
