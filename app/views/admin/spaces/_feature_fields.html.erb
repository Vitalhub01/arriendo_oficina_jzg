<%# locals: space:, equipment_items:, amenity_tags: %>
<fieldset class="rounded-xl border border-gray-200 bg-gray-50/80 p-4 space-y-4">
  <legend class="px-1 text-sm font-semibold text-gray-900">Implementos y etiquetas</legend>
  <p class="text-xs text-gray-600">
    Elige del catálogo.
    <%= link_to "Gestionar implementos", admin_equipment_items_path, class: "text-brand hover:underline" %>
    ·
    <%= link_to "Gestionar etiquetas", admin_amenity_tags_path, class: "text-brand hover:underline" %>
  </p>

  <div class="rounded-lg border border-gray-200 bg-white p-4 space-y-3">
    <p class="text-sm font-medium text-gray-900">Arriendo opcional de implementos (por hora)</p>
    <p class="text-xs text-gray-600">
      Si defines un precio, en el checkout por hora aparecerá un checkbox para sumar ese valor por cada hora reservada.
      Déjalo vacío para desactivar la opción en este espacio.
    </p>
    <%= label_tag "space[equipment_usage_price_per_hour_cents]", "Precio adicional por hora (CLP)", class: "block text-sm font-medium" %>
    <%= number_field_tag "space[equipment_usage_price_per_hour_cents]",
          space.equipment_usage_price_per_hour_cents,
          class: "input-field max-w-xs",
          min: 1,
          step: 1,
          placeholder: "Ej. 500" %>
    <%= label_tag "space[equipment_usage_label]", "Texto en el checkout (opcional)", class: "block text-sm font-medium" %>
    <%= text_field_tag "space[equipment_usage_label]",
          space.equipment_usage_label,
          class: "input-field",
          placeholder: "Uso de implementos" %>
  </div>

  <div>
    <p class="text-sm font-medium text-gray-900">Implementos de este espacio</p>
    <%= hidden_field_tag "space[equipment_item_ids][]", "", id: nil %>
    <div class="mt-2 grid gap-2 sm:grid-cols-2">
      <% equipment_items.each do |item| %>
        <label class="flex items-center gap-2 text-sm text-gray-700">
          <%= check_box_tag "space[equipment_item_ids][]",
                            item.id,
                            space.equipment_item_ids.include?(item.id),
                            id: "space_equipment_item_#{item.id}",
                            class: "rounded border-gray-300" %>
          <%= item.name %>
        </label>
      <% end %>
    </div>
    <% if equipment_items.empty? %>
      <p class="mt-2 text-sm text-amber-800">No hay implementos en el catálogo. Crea algunos primero.</p>
    <% end %>
  </div>

  <div>
    <p class="text-sm font-medium text-gray-900">Etiquetas de este espacio</p>
    <%= hidden_field_tag "space[amenity_tag_ids][]", "", id: nil %>
    <div class="mt-2 flex flex-wrap gap-3">
      <% amenity_tags.each do |tag| %>
        <label class="inline-flex items-center gap-2 rounded-full border border-gray-200 bg-white px-3 py-1.5 text-sm text-gray-700">
          <%= check_box_tag "space[amenity_tag_ids][]",
                            tag.id,
                            space.amenity_tag_ids.include?(tag.id),
                            id: "space_amenity_tag_#{tag.id}",
                            class: "rounded border-gray-300" %>
          <%= tag.name %>
        </label>
      <% end %>
    </div>
    <% if amenity_tags.empty? %>
      <p class="mt-2 text-sm text-amber-800">No hay etiquetas en el catálogo. Crea algunas primero.</p>
    <% end %>
  </div>
</fieldset>
