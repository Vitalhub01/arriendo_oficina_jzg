<h1 class="text-2xl font-bold">Galería del inicio</h1>
<p class="mt-2 max-w-2xl text-sm text-gray-600">
  Estas fotos aparecen en la sección «Conoce nuestros espacios» de la página principal.
  Puedes subir imágenes, ordenarlas y asignar una etiqueta a cada una.
</p>

<div class="mt-6 max-w-3xl">
  <%= render "admin/shared/photo_manager",
      items: @gallery_items,
      item_partial: "admin/gallery_items/item",
      item_locals: ->(item) { { item: item } },
      create_url: admin_gallery_items_path,
      reorder_url: reorder_admin_gallery_items_path,
      update_url_template: admin_gallery_item_path(":id"),
      destroy_url_template: admin_gallery_item_path(":id"),
      show_tag: true,
      datalist_id: "gallery-tag-suggestions",
      empty_message: "Aún no hay fotos en la galería. Sube la primera imagen con el área de abajo." %>
</div>
