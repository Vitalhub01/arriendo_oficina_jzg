<div class="flex gap-3 rounded-xl border border-gray-200 bg-gray-50 p-3"
     data-photo-manager-target="item"
     data-photo-id="<%= item.id %>"
     draggable="true"
     data-action="dragstart->photo-manager#dragStart dragend->photo-manager#dragEnd">
  <button type="button"
          class="flex shrink-0 cursor-grab items-center self-stretch rounded-lg px-2 text-gray-400 hover:bg-white hover:text-gray-600"
          aria-label="Arrastrar para reordenar"
          tabindex="-1">
    <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 20 20" aria-hidden="true">
      <path d="M7 4a1 1 0 100 2 1 1 0 000-2zm6 0a1 1 0 100 2 1 1 0 000-2zM7 9a1 1 0 100 2 1 1 0 000-2zm6 0a1 1 0 100 2 1 1 0 000-2zM7 14a1 1 0 102 0 1 1 0 00-2 0zm6 0a1 1 0 102 0 1 1 0 00-2 0z"/>
    </svg>
  </button>

  <div class="h-24 w-32 shrink-0 overflow-hidden rounded-lg bg-gray-200">
    <% if item.image.attached? %>
      <%= image_tag item.image.variant(resize_to_limit: [320, 240]), class: "h-full w-full object-cover", alt: item.display_alt %>
    <% end %>
  </div>

  <div class="min-w-0 flex-1 space-y-2">
    <label class="block text-xs font-medium text-gray-600">Etiqueta del conjunto</label>
    <input type="text"
           value="<%= item.tag %>"
           list="gallery-tag-suggestions"
           placeholder="Ej: Box clínico (agrupa fotos en el sitio)"
           class="input-field !py-2 text-sm"
           data-action="change->photo-manager#saveTag">
    <label class="block text-xs font-medium text-gray-600">Texto alternativo (accesibilidad)</label>
    <input type="text"
           value="<%= item.alt_text %>"
           placeholder="Descripción breve de la imagen"
           class="input-field !py-2 text-sm"
           data-action="change->photo-manager#saveAlt">
  </div>

  <button type="button"
          class="shrink-0 self-start rounded-lg px-2 py-1 text-sm text-red-600 hover:bg-red-50"
          data-action="photo-manager#removePhoto">
    Eliminar
  </button>
</div>
