<h1 class="text-2xl font-bold">Membresías activas</h1>
<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Usuario</th>
        <th>Plan</th>
        <th>Vence</th>
        <th>Estado</th>
      </tr>
    </thead>
    <tbody>
      <% @memberships.each do |m| %>
        <tr>
          <td class="font-medium text-gray-900"><%= m.user.name %></td>
          <td><%= m.membership_plan.name %></td>
          <td><%= l(m.expires_at, format: :short) %></td>
          <td><%= m.status %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>
