<h1 class="text-2xl font-bold">Configuración</h1>

<%= form_with url: admin_site_settings_path, method: :patch, class: "mt-6 max-w-xl space-y-8" do %>
  <section class="space-y-4 rounded-xl border border-gray-200 bg-white p-6">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Textos de navegación</h2>
      <p class="mt-1 text-sm text-gray-600">Barra superior, menú principal y enlaces del pie de página.</p>
    </div>
    <% @nav_settings.each do |key, value| %>
      <%= label_tag "site_nav_settings[#{key}]", SiteNavigationSettings::LABELS[key], class: "block text-sm font-medium" %>
      <%= text_field_tag "site_nav_settings[#{key}]", value, class: "input-field" %>
    <% end %>
  </section>

  <section class="space-y-4 rounded-xl border border-gray-200 bg-white p-6">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Funciones del sitio</h2>
      <p class="mt-1 text-sm text-gray-600">
        Activa o desactiva secciones públicas y menús de administración. La membresía queda oculta mientras esté desactivada.
      </p>
    </div>
    <label class="flex cursor-pointer items-start gap-3">
      <%= hidden_field_tag "site_feature_settings[memberships_enabled]", "0" %>
      <%= check_box_tag "site_feature_settings[memberships_enabled]", "1", @memberships_enabled,
            class: "mt-1 h-4 w-4 rounded border-gray-300 text-brand focus:ring-brand" %>
      <span>
        <span class="block text-sm font-medium text-gray-900">Membresía visible</span>
        <span class="block text-sm text-gray-600">Enlaces en inicio, navegación, planes y pagos de membresía.</span>
      </span>
    </label>
  </section>

  <section class="space-y-4">
    <h2 class="text-lg font-semibold text-gray-900">Opciones generales</h2>
    <% @settings.each do |key, value| %>
      <%= label_tag "site_settings[#{key}]", key.humanize, class: "block text-sm font-medium" %>
      <%= text_field_tag "site_settings[#{key}]", value, class: "input-field" %>
    <% end %>
  </section>

  <%= submit_tag "Guardar", class: "btn-primary" %>
<% end %>
