<h1 class="text-2xl font-bold">Configuración</h1>

<%= form_with url: admin_site_settings_path, method: :patch, multipart: true, class: "mt-6 max-w-xl space-y-8" do %>
  <section class="space-y-4 rounded-xl border border-gray-200 bg-white p-6">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Logo y foto principal</h2>
      <p class="mt-1 text-sm text-gray-600">Se muestran en la barra de navegación, el pie de página y el bloque destacado de la página de inicio.</p>
    </div>

    <% if @branding.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
        <ul class="list-disc pl-5">
          <% @branding.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div>
      <%= label_tag "site_branding[logo]", "Logo", class: "block text-sm font-medium" %>
      <div class="mt-2 flex items-center gap-4">
        <%= image_tag site_logo(@branding), alt: "Logo actual", class: "h-16 w-auto max-w-[200px] object-contain rounded border border-gray-200 bg-gray-50 p-2" %>
        <p class="text-xs text-gray-500">PNG, JPG o WebP. Si no subes uno, se usa el logo predeterminado del sitio.</p>
      </div>
      <%= file_field_tag "site_branding[logo]", accept: "image/png,image/jpeg,image/webp", class: "input-field mt-2" %>
    </div>

    <div>
      <%= label_tag "site_branding[hero_image]", "Foto principal (inicio)", class: "block text-sm font-medium" %>
      <div class="mt-2">
        <%= image_tag site_hero_image(@branding), alt: "Foto principal actual", class: "aspect-[4/3] w-full max-w-sm rounded-lg border border-gray-200 object-cover" %>
        <p class="mt-2 text-xs text-gray-500">Imagen grande del hero en la página de inicio. PNG, JPG o WebP.</p>
      </div>
      <%= file_field_tag "site_branding[hero_image]", accept: "image/png,image/jpeg,image/webp", class: "input-field mt-2" %>
    </div>
  </section>

  <section class="space-y-4">
    <h2 class="text-lg font-semibold text-gray-900">Opciones generales</h2>
    <% @settings.each do |key, value| %>
      <%= label_tag "site_settings[#{key}]", key.humanize, class: "block text-sm font-medium" %>
      <%= text_field_tag "site_settings[#{key}]", value, class: "input-field" %>
    <% end %>
  </section>

  <%= submit_tag "Guardar", class: "btn-primary" %>
<% end %>
