<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Dueños</h1>
  <%= link_to "Nuevo dueño", new_admin_user_path, class: "btn-primary" %>
</div>

<table class="mt-6 w-full text-left text-sm">
  <thead><tr class="border-b"><th class="py-2">Nombre</th><th>Email</th><th>Rol</th><th></th></tr></thead>
  <tbody>
    <% @users.each do |user| %>
      <tr class="border-b">
        <td class="py-3"><%= user.name %></td>
        <td><%= user.email %></td>
        <td><%= user.role %></td>
        <td><%= link_to "Editar", edit_admin_user_path(user), class: "text-brand hover:underline" %></td>
      </tr>
    <% end %>
  </tbody>
</table>
