<div class="flex flex-wrap items-center justify-between gap-4">
  <div>
    <h1 class="text-2xl font-bold">Usuarios y permisos</h1>
    <p class="mt-1 text-sm text-gray-600">Asigna roles y gestiona el acceso al sitio.</p>
  </div>
</div>

<%= form_with url: admin_users_path, method: :get, class: "mt-6 flex flex-wrap items-end gap-3", data: { turbo_frame: "_top" } do %>
  <div class="min-w-[12rem] flex-1">
    <label class="block text-sm font-medium text-gray-700">Buscar</label>
    <input type="search" name="q" value="<%= params[:q] %>" placeholder="Nombre o email" class="input-field mt-1 w-full">
  </div>
  <div>
    <label class="block text-sm font-medium text-gray-700">Rol</label>
    <select name="role" class="input-field mt-1">
      <option value="">Todos</option>
      <% User.roles.each_key do |role| %>
        <option value="<%= role %>" <%= 'selected' if params[:role] == role %>><%= User::ROLE_LABELS[role] %></option>
      <% end %>
    </select>
  </div>
  <button type="submit" class="btn-secondary">Filtrar</button>
  <% if params[:q].present? || params[:role].present? %>
    <%= link_to "Limpiar", admin_users_path, class: "text-sm text-brand hover:underline" %>
  <% end %>
<% end %>

<div class="admin-table-card mt-6">
  <table class="admin-table">
    <thead>
      <tr>
        <th>Nombre</th>
        <th>Email</th>
        <th>Rol</th>
        <th>Estado</th>
        <th>Último acceso</th>
        <th class="admin-table__actions"></th>
      </tr>
    </thead>
    <tbody>
      <% @users.each do |user| %>
        <tr>
          <td class="font-medium text-gray-900">
            <%= user.name %>
            <% if user.id == current_user.id %>
              <span class="ml-1 text-xs font-normal text-gray-500">(tú)</span>
            <% end %>
          </td>
          <td><%= user.email %></td>
          <td>
            <span class="inline-flex rounded-full px-2 py-0.5 text-xs font-medium <%= user.admin? ? 'bg-violet-100 text-violet-800' : 'bg-gray-100 text-gray-800' %>">
              <%= user.role_label %>
            </span>
          </td>
          <td>
            <% if user.banned? %>
              <span class="text-red-600">Bloqueado</span>
            <% else %>
              <span class="text-green-700">Activo</span>
            <% end %>
          </td>
          <td class="text-gray-500">
            <%= user.last_sign_in_at ? l(user.last_sign_in_at, format: :short) : '—' %>
          </td>
          <td class="admin-table__actions">
            <%= link_to "Permisos", edit_admin_user_path(user), class: "text-brand hover:underline" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
</div>

<%== pagy_nav(@pagy) if @pagy.pages > 1 %>
