<h1 class="text-2xl font-bold">Nuevo dueño</h1>
<%= form_with model: [:admin, @user], class: "mt-6 max-w-md space-y-4" do |f| %>
  <%= f.label :name %><%= f.text_field :name, class: "input-field" %>
  <%= f.label :email %><%= f.email_field :email, class: "input-field" %>
  <%= f.hidden_field :role, value: "owner" %>
  <%= f.label :password, "Contraseña temporal" %><%= f.password_field :password, class: "input-field" %>
  <%= f.submit "Crear dueño", class: "btn-primary" %>
<% end %>
