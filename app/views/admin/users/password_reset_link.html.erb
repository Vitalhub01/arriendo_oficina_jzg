<% whatsapp_message = password_reset_whatsapp_message(user: @user, url: @password_reset_url) %>

<div class="max-w-3xl">
  <%= link_to "← Usuarios", admin_users_path, class: "text-sm text-brand hover:underline" %>
  <h1 class="mt-2 text-2xl font-bold">Reestablecer contraseña</h1>
  <p class="mt-1 text-sm text-gray-600"><%= @user.name %> · <%= @user.email %></p>

  <section class="admin-form-section mt-8">
    <header class="admin-form-section__header">
      <p class="admin-form-section__title">Enlace para compartir</p>
      <p class="admin-form-section__hint">
        El usuario abrirá el formulario para elegir una nueva contraseña. El enlace es de un solo uso y caduca
        <%= password_reset_validity_label %> después de generarse (estándar habitual en plataformas empresariales).
        Si generas uno nuevo, el anterior deja de servir.
      </p>
    </header>
    <div class="admin-form-section__body space-y-4">
      <div class="flex flex-wrap items-center gap-2 text-sm">
        <span class="inline-flex items-center rounded-full bg-amber-50 px-2.5 py-1 font-medium text-amber-900 ring-1 ring-amber-200/80">
          Vence <%= l(@password_reset_expires_at, format: :short) %>
        </span>
        <span class="text-gray-500">(<%= password_reset_validity_label %> desde ahora)</span>
      </div>

      <p class="break-all rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 font-mono text-sm text-gray-800">
        <%= @password_reset_url %>
      </p>

      <div class="flex flex-wrap gap-2">
        <%= link_to whatsapp_share_url(whatsapp_message),
              target: "_blank",
              rel: "noopener noreferrer",
              class: "inline-flex min-h-[44px] items-center justify-center gap-2 rounded-none bg-[#25D366] px-5 py-2.5 text-sm font-medium uppercase tracking-wide text-white transition hover:bg-[#1da851] focus:outline-none focus:ring-2 focus:ring-[#25D366] focus:ring-offset-2" do %>
          <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.435 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
          </svg>
          Compartir link por WP
        <% end %>
        <%= link_to "Generar enlace nuevo", password_reset_link_admin_user_path(@user), class: "btn-secondary" %>
        <%= link_to "Permisos del usuario", edit_admin_user_path(@user), class: "btn-secondary" %>
      </div>
    </div>
  </section>
</div>
