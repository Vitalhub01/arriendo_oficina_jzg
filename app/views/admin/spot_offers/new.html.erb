<h1 class="text-2xl font-bold">Nueva tarifa spot</h1>
<p class="mt-2 max-w-2xl text-sm text-gray-600">
  Define un paquete de fechas y franja horaria (por ejemplo mañanas 08:00–14:00 de todo un mes).
  Se generará un enlace para que un profesional pague todas las sesiones de una vez.
</p>

<%= form_with model: @spot_offer, url: admin_spot_offers_path, class: "mt-6 max-w-xl space-y-4" do |f| %>
  <% if @spot_offer.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
      <ul class="list-disc pl-5">
        <% @spot_offer.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <%= f.label :space_id, "Espacio", class: "block text-sm font-medium" %>
  <%= f.collection_select :space_id, @spaces, :id, :title, { prompt: "Elige un espacio" }, class: "input-field", required: true %>

  <%= f.label :title, "Nombre interno (opcional)", class: "block text-sm font-medium" %>
  <%= f.text_field :title, class: "input-field", placeholder: "Ej. Mañanas octubre" %>

  <%= f.label :total_price_cents, "Precio total (CLP)", class: "block text-sm font-medium" %>
  <%= f.number_field :total_price_cents, class: "input-field", min: 1, step: 1, required: true %>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :starts_on, "Desde", class: "block text-sm font-medium" %>
      <%= f.date_field :starts_on, class: "input-field", required: true %>
    </div>
    <div>
      <%= f.label :ends_on, "Hasta", class: "block text-sm font-medium" %>
      <%= f.date_field :ends_on, class: "input-field", required: true %>
    </div>
  </div>

  <div class="grid grid-cols-2 gap-4">
    <div>
      <%= f.label :daily_start_time, "Hora inicio diaria", class: "block text-sm font-medium" %>
      <%= f.time_field :daily_start_time, class: "input-field", required: true %>
      <p class="mt-1 text-xs text-gray-500">Bloque mañana: 08:00</p>
    </div>
    <div>
      <%= f.label :daily_end_time, "Hora fin diaria", class: "block text-sm font-medium" %>
      <%= f.time_field :daily_end_time, class: "input-field", required: true %>
      <p class="mt-1 text-xs text-gray-500">Bloque mañana: 14:00 · tarde: 20:00</p>
    </div>
  </div>

  <%= f.submit "Crear y generar enlace", class: "btn-primary" %>
<% end %>
