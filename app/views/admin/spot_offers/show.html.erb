<div class="max-w-3xl">
  <%= link_to "← Tarifas spot", admin_spot_offers_path, class: "text-sm text-brand hover:underline" %>
  <h1 class="mt-2 text-2xl font-bold">Tarifa spot</h1>
  <p class="mt-1 text-gray-600"><%= @spot_offer.space.title %></p>

  <section class="admin-form-section mt-8">
    <header class="admin-form-section__header">
      <h2 class="admin-form-section__title">Resumen del paquete</h2>
      <p class="admin-form-section__hint"><%= @spot_offer.recurrence_description %></p>
    </header>
    <div class="admin-form-section__body">
      <dl class="space-y-3 text-sm">
        <div class="flex justify-between gap-4 border-b border-gray-100 pb-3">
          <dt class="text-gray-500">Repetición</dt>
          <dd class="text-right font-medium text-gray-900"><%= @spot_offer.weekdays_summary %></dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-gray-100 pb-3">
          <dt class="text-gray-500">Horario</dt>
          <dd class="text-right font-medium text-gray-900">
            <%= @spot_offer.daily_start_time.strftime('%H:%M') %> – <%= @spot_offer.daily_end_time.strftime('%H:%M') %>
          </dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-gray-100 pb-3">
          <dt class="text-gray-500">Periodo</dt>
          <dd class="text-right font-medium text-gray-900"><%= l(@spot_offer.starts_on) %> — <%= l(@spot_offer.ends_on) %></dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-gray-100 pb-3">
          <dt class="text-gray-500">Sesiones estimadas</dt>
          <dd class="text-right font-medium text-gray-900"><%= @spot_offer.occurrence_count %></dd>
        </div>
        <div class="flex justify-between gap-4 border-b border-gray-100 pb-3">
          <dt class="text-gray-500">Total</dt>
          <dd class="text-right font-semibold text-gray-900"><%= format_clp(@spot_offer.total_price_cents) %></dd>
        </div>
        <div class="flex justify-between gap-4">
          <dt class="text-gray-500">Estado</dt>
          <dd class="text-right font-medium text-gray-900"><%= @spot_offer.status %></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="admin-form-section mt-8">
    <header class="admin-form-section__header">
      <p class="admin-form-section__title">Enlace para compartir</p>
      <p class="admin-form-section__hint">El profesional debe iniciar sesión para pagar el paquete completo.</p>
    </header>
    <div class="admin-form-section__body">
      <p class="break-all rounded-lg border border-gray-200 bg-gray-50 px-4 py-3 font-mono text-sm text-gray-800">
        <%= spot_offer_url(@spot_offer.token) %>
      </p>
    </div>
  </section>
</div>
