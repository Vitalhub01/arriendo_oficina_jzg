<h1 class="text-2xl font-bold">Tarifa spot</h1>
<p class="mt-1 text-gray-600"><%= @spot_offer.space.title %></p>

<dl class="mt-6 max-w-lg space-y-2 text-sm">
  <div class="flex justify-between"><dt class="text-gray-500">Rango</dt><dd><%= l(@spot_offer.starts_on) %> — <%= l(@spot_offer.ends_on) %></dd></div>
  <div class="flex justify-between"><dt class="text-gray-500">Horario diario</dt><dd><%= @spot_offer.daily_start_time.strftime('%H:%M') %> – <%= @spot_offer.daily_end_time.strftime('%H:%M') %></dd></div>
  <div class="flex justify-between"><dt class="text-gray-500">Sesiones estimadas</dt><dd><%= @spot_offer.occurrence_count %></dd></div>
  <div class="flex justify-between"><dt class="text-gray-500">Total</dt><dd class="font-semibold"><%= format_clp(@spot_offer.total_price_cents) %></dd></div>
  <div class="flex justify-between"><dt class="text-gray-500">Estado</dt><dd><%= @spot_offer.status %></dd></div>
</dl>

<div class="mt-8 rounded-xl border border-gray-200 bg-white p-6">
  <p class="text-sm font-medium text-gray-900">Enlace para compartir</p>
  <p class="mt-2 break-all rounded-lg bg-gray-50 p-3 font-mono text-sm"><%= spot_offer_url(@spot_offer.token) %></p>
  <p class="mt-2 text-xs text-gray-500">El profesional debe iniciar sesión para pagar el paquete completo.</p>
</div>

<%= link_to "Volver al listado", admin_spot_offers_path, class: "mt-6 inline-block text-brand hover:underline" %>
