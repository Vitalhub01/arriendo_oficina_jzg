<%# locals: amenity_tag:, space: %>
<div id="amenity_tag_quick_add">
  <%= form_with model: [:admin, amenity_tag],
        url: admin_amenity_tags_path,
        class: "mt-3 rounded-lg border border-dashed border-gray-300 bg-white p-3" do |f| %>
    <%= hidden_field_tag :inline, "1" %>
    <%= hidden_field_tag :from_space_id, space.id if space.persisted? %>
    <% if amenity_tag.errors.any? %>
      <p class="mb-2 text-sm text-red-700"><%= amenity_tag.errors.full_messages.to_sentence %></p>
    <% end %>
    <p class="text-xs font-medium text-gray-700">Agregar etiqueta al catálogo</p>
    <div class="mt-2 flex flex-wrap items-end gap-2">
      <%= f.text_field :name, placeholder: "Nombre", class: "input-field min-w-[10rem] flex-1", required: true %>
      <%= f.submit "Agregar", class: "btn-secondary shrink-0" %>
    </div>
  <% end %>
</div>
