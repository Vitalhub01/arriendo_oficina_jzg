<div class="mt-4">
  <div class="flex items-center justify-between">
    <% prev_week = week_start - 1.week %>
    <% next_week = week_start + 1.week %>
    <%= link_to "← Semana anterior", availability_box_path(box, week_start: prev_week), class: "text-sm font-medium text-brand hover:underline", data: { turbo_frame: "availability_schedule" } %>
    <span class="text-sm text-gray-600"><%= l(week_start, format: :short) %> — <%= l(week_start + 6.days, format: :short) %></span>
    <%= link_to "Semana siguiente →", availability_box_path(box, week_start: next_week), class: "text-sm font-medium text-brand hover:underline", data: { turbo_frame: "availability_schedule" } %>
  </div>

  <div class="mt-4 overflow-x-auto">
    <div class="min-w-[640px] grid grid-cols-7 gap-2">
      <% schedule.each do |day| %>
        <div class="rounded-xl border border-gray-200 p-2">
          <p class="text-center text-xs font-semibold text-gray-700"><%= day[:day_name][0..2] %></p>
          <p class="text-center text-[10px] text-gray-400"><%= l(day[:date], format: "%d/%m") %></p>
          <div class="mt-2 space-y-1">
            <% if day[:slots].any? %>
              <% day[:slots].each do |slot| %>
                <div class="rounded px-1 py-0.5 text-center text-[10px] <%= slot.available ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-400 line-through' %>">
                  <%= "%02d:00" % slot.hour %>
                </div>
              <% end %>
            <% else %>
              <p class="text-center text-[10px] text-gray-300">—</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <p class="mt-3 text-xs text-gray-500">
    <span class="inline-block h-2 w-2 rounded-full bg-green-400"></span> Disponible
    <span class="ml-3 inline-block h-2 w-2 rounded-full bg-gray-300"></span> Ocupado
  </p>
</div>
