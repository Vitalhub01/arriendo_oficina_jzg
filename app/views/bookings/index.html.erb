<div class="mx-auto max-w-7xl px-4 py-8">
  <% unless current_user.profile_complete? %>
    <div class="mb-6 max-w-3xl">
      <%= render "shared/profile_incomplete_reminder", variant: :after_booking %>
    </div>
  <% end %>
  <h1 class="text-2xl font-bold">Mis reservas</h1>

  <nav class="mt-6 flex flex-wrap gap-2 border-b border-gray-200" aria-label="Filtrar reservas">
    <% BookingsController::BOOKING_INDEX_FILTERS.each do |key, config| %>
      <% active = @filter == key %>
      <%= link_to bookings_path(filter: key),
                  class: "rounded-t-lg px-4 py-2.5 text-sm font-medium transition-colors #{active ? 'border-b-2 border-brand text-brand -mb-px' : 'text-gray-600 hover:text-gray-900'}" do %>
        <%= config[:label] %>
        <span class="ml-1.5 rounded-full bg-gray-100 px-2 py-0.5 text-xs font-normal text-gray-700 <%= 'bg-brand/10 text-brand' if active %>">
          <%= @filter_counts[key] %>
        </span>
      <% end %>
    <% end %>
  </nav>

  <div class="mt-6 space-y-4">
    <% if @bookings.any? %>
      <% show_testimonial_action = @filter == 'confirmed' %>
      <% @bookings.each do |booking| %>
        <%= render "booking_row", booking: booking, show_testimonial_action: show_testimonial_action %>
      <% end %>
    <% else %>
      <p class="rounded-xl border border-dashed border-gray-200 bg-gray-50 px-4 py-8 text-center text-sm text-gray-600">
        <%= bookings_index_empty_message(@filter) %>
      </p>
    <% end %>
  </div>

  <div class="mt-8"><%== pagy_nav(@pagy, params: { filter: @filter }) if @pagy.pages > 1 %></div>
</div>
