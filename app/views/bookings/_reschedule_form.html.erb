<%# locals: (booking:, reschedule_mode:, week_start:, schedule_payload:, reschedule_date: nil) %>
<% schedule_title =
     case reschedule_mode
     when "jornada" then "Elige un día disponible"
     when "bloque" then "Elige día y bloque (mañana o tarde)"
     else "Elige día y franja de inicio"
     end %>
<% reschedule_date = reschedule_date || params[:date].presence&.to_date || (booking.start_at.to_date + 7.days) %>
<div data-controller="reschedule-form"
     data-reschedule-form-mode-value="<%= reschedule_mode %>"
     data-reschedule-form-minimum-slots-value="<%= booking.space.minimum_slots %>"
     data-reschedule-form-slot-count-value="<%= booking.slot_count %>"
     data-reschedule-form-blocks-by-day-value="<%= space_booking_blocks_by_day(booking.space).to_json %>"
     data-reschedule-form-overrides-value="<%= space_booking_block_overrides(booking.space).to_json %>"
     data-reschedule-form-today-value="<%= Date.current.iso8601 %>"
     data-reschedule-form-now-time-value="<%= Time.zone.now.strftime('%H:%M') %>"
     data-reschedule-form-slot-rates-value="<%= space_booking_slot_rates_payload(booking.space).to_json %>"
     data-reschedule-form-reserved-intervals-value="<%= space_booking_reserved_intervals(booking.space, for_user: current_user).to_json %>">
  <section class="mb-4">
    <h3 class="text-sm font-semibold text-gray-900"><%= schedule_title %></h3>
    <p class="mt-1 text-xs text-gray-500">
      Reserva actual:
      <span class="font-medium text-gray-700">
        <%= l(booking.start_at.to_date, format: :long) %>
        · <%= l(booking.start_at, format: "%H:%M") %>–<%= l(booking.end_at, format: "%H:%M") %>
      </span>
    </p>
    <%= turbo_frame_tag "reschedule_availability_schedule",
          data: space_availability_schedule_frame_data(
            booking.space,
            schedule_payload,
            availability_url: availability_booking_path(booking),
            form_controller: "reschedule-form",
            sync_booking_form: false
          ) do %>
      <%= render "spaces/availability_schedule",
            space: booking.space,
            week_start: week_start,
            interactive: true,
            login_prompt_on_slots: false,
            initial_view: reschedule_mode,
            show_view_toggles: false,
            hint: "Haz clic en una franja disponible (verde). Se completará el formulario abajo." %>
    <% end %>
  </section>

  <%= form_with url: reschedule_booking_path(booking), method: :patch, class: "space-y-4", data: { turbo: false } do %>
    <div>
      <p class="font-medium">Nuevo horario</p>
      <p class="mt-1 text-sm text-gray-600">
        <% case reschedule_mode %>
        <% when "jornada" %>
          Mantendremos el arriendo por <strong>día completo</strong> con el crédito de esta reserva. Solo cambia la fecha.
        <% when "bloque" %>
          Mantendremos el arriendo por <strong>bloque</strong> (mañana o tarde). Puedes cambiar de bloque; si el precio es distinto, se cobrará o acreditará la diferencia.
        <% else %>
          Mantendremos la misma cantidad de horas (<strong><%= booking.slot_count %></strong>).
          Elige solo franjas libres en el calendario; si el nuevo horario cuesta más, pagarás la diferencia antes de confirmar.
        <% end %>
      </p>
      <p class="mt-2 text-sm font-medium text-brand" data-reschedule-form-target="selectionSummary">Elige un horario en el calendario.</p>
    </div>

    <%= hidden_field_tag :reservation_mode, reschedule_mode, data: { reschedule_form_target: "reservationMode" } %>

    <div>
      <%= label_tag :date, "Fecha", class: "block text-sm font-medium" %>
      <%= date_field_tag :date,
            reschedule_date,
            min: Date.current,
            class: "input-field",
            required: true,
            data: { reschedule_form_target: "date", action: "change->reschedule-form#dateChanged" } %>
    </div>

    <% if reschedule_mode == "bloque" %>
      <% current_rate = booking.reschedule_slot_rate %>
      <% selectable_rates = space_selectable_bloque_slot_rates(booking.space, reschedule_date, for_user: current_user) %>
      <div>
        <%= label_tag :slot_rate_id, "Bloque del día", class: "block text-sm font-medium" %>
        <%= select_tag :slot_rate_id,
              options_from_collection_for_select(
                selectable_rates.presence || booking.space.bloque_slot_rates,
                :id,
                ->(r) {
                  "#{r.name} (#{r.start_time.strftime('%H:%M')} – #{r.end_time.strftime('%H:%M')})"
                },
                current_rate&.id
              ),
              class: "input-field",
              required: true,
              data: { reschedule_form_target: "slotRate", action: "change->reschedule-form#fieldChanged" } %>
        <p class="mt-1 hidden text-sm text-red-700" data-reschedule-form-target="bloqueWarning"></p>
      </div>
    <% elsif reschedule_mode == "hora" %>
      <div>
        <%= label_tag :start_time, "Franja de inicio", class: "block text-sm font-medium" %>
        <%= select_tag :start_time,
              options_for_select(
                space_booking_start_time_options(booking.space, reschedule_date, for_user: current_user),
                nil
              ),
              include_blank: "Elige una franja en el calendario",
              class: "input-field",
              required: true,
              data: { reschedule_form_target: "startTime", action: "change->reschedule-form#fieldChanged" } %>
        <p class="mt-1 hidden text-sm text-red-700" data-reschedule-form-target="horaWarning"></p>
      </div>
      <%= hidden_field_tag :slot_count,
            booking.slot_count,
            data: { reschedule_form_target: "slotCount" } %>
    <% end %>

    <% reschedule_confirm = "¿Confirmas reagendar? Se aplicará un crédito por el valor de esta reserva. Si el nuevo horario cuesta más, deberás pagar la diferencia para confirmar el cambio." %>
    <%= submit_tag "Reagendar reserva",
          class: "btn-primary",
          data: { reschedule_form_target: "submit" },
          onclick: "return confirm(#{reschedule_confirm.to_json})" %>
  <% end %>
</div>
