<%= turbo_frame_tag GalleriesController::MAIN_PHOTO_FRAME do %>
  <div class="flex flex-col gap-2"
       data-controller="gallery-set"
       data-action="keydown@window->gallery-set#handleKey"
       data-gallery-set-prev-url-value="<%= @prev_item ? gallery_path(tag: @tag_slug, photo_id: @prev_item.id) : '' %>"
       data-gallery-set-next-url-value="<%= @next_item ? gallery_path(tag: @tag_slug, photo_id: @next_item.id) : '' %>">

    <%# Fila 1: miniaturas (ancho fijo; no flex-1 para que no ocupen medio viewport) %>
    <nav class="w-full" aria-label="Todas las fotos de la galería">
      <ul class="m-0 flex list-none flex-row flex-wrap justify-start gap-1.5 p-0 sm:gap-2">
        <% @items.each do |item| %>
          <% selected = item.id == @item.id %>
          <li class="shrink-0">
            <%= link_to gallery_path(tag: @tag_slug, photo_id: item.id),
                class: "block w-32 overflow-hidden rounded-md focus:outline-none focus-visible:ring-2 focus-visible:ring-brand focus-visible:ring-offset-1 #{selected ? 'ring-2 ring-brand' : 'ring-1 ring-gray-200 hover:ring-gray-300'}",
                data: { turbo_frame: GalleriesController::MAIN_PHOTO_FRAME, turbo_action: 'advance' },
                aria: { label: item.display_alt, current: selected } do %>
              <% if item.image.attached? %>
                <%= lazy_variant_image item.image,
                      alt: '',
                      aspect_class: "aspect-[4/3] w-32",
                      resize_to_limit: LazyImageHelper::VARIANT_LIMITS_GALLERY_THUMB,
                      eager: selected,
                      animated: false,
                      wrapper_class: "w-32 rounded-md" %>
              <% end %>
            <% end %>
          </li>
        <% end %>
      </ul>
    </nav>

    <%# Fila 2: foto seleccionada (grande) %>
    <div class="w-full max-h-[min(52vh,36rem)]">
      <% if @item.image.attached? %>
        <%= lazy_variant_image @item.image,
              alt: @item.display_alt,
              aspect_class: "aspect-[4/3] max-h-[min(52vh,36rem)] w-full",
              resize_to_limit: LazyImageHelper::VARIANT_LIMITS_GALLERY_MAIN,
              eager: true,
              animated: false,
              wrapper_class: "overflow-hidden rounded-lg ring-1 ring-black/5 max-h-[min(52vh,36rem)]" %>
      <% else %>
        <div class="flex aspect-[4/3] items-center justify-center rounded-lg bg-gray-100 text-sm text-gray-400 ring-1 ring-black/5">
          Sin imagen
        </div>
      <% end %>
      <% if @item.alt_text.present? %>
        <p class="mt-1.5 line-clamp-2 text-xs text-gray-600 sm:text-sm"><%= @item.alt_text %></p>
      <% end %>
    </div>
  </div>
<% end %>
