<% content_for :title, "#{@tag_label} — Galería | VitalHub" %>
<% content_for :meta_description, @tag_description.presence || "Fotos de #{@tag_label} en VitalHub. Conoce nuestros espacios para profesionales de la salud." %>
<% if @highlight_item.image.attached? %>
  <% content_for :og_image, url_for(@highlight_item.image) %>
<% end %>

<div class="mx-auto max-w-4xl px-4 pb-6 pt-3 md:pt-4">
  <div class="mb-3 flex flex-wrap items-baseline gap-x-2 gap-y-1">
    <%= link_to "← Galería", root_path(anchor: "galeria"), class: "shrink-0 text-sm text-brand hover:underline" %>
    <span class="hidden text-gray-300 sm:inline" aria-hidden="true">·</span>
    <h1 class="text-base font-medium capitalize text-gray-900 sm:text-lg"><%= @tag_label %></h1>
  </div>

  <% if @tag_description.present? %>
    <p class="mb-3 line-clamp-2 text-xs leading-snug text-gray-500 sm:text-sm"><%= @tag_description %></p>
  <% end %>

  <%= render "galleries/main_photo_frame" %>
</div>
