<% content_for :title, "#{@tag_label} — Galería | VitalHub" %>
<% content_for :meta_description, @tag_description.presence || "Fotos de #{@tag_label} en VitalHub. Conoce nuestros espacios para profesionales de la salud." %>
<% if @highlight_item.image.attached? %>
  <% content_for :og_image, url_for(@highlight_item.image) %>
<% end %>

<div class="mx-auto max-w-4xl px-4 py-8 md:py-12">
  <p class="text-sm">
    <%= link_to "← Volver al inicio", root_path(anchor: "galeria"), class: "text-brand hover:underline" %>
  </p>

  <header class="mt-4 border-b border-gray-200 pb-6">
    <p class="shop-eyebrow">Galería</p>
    <h1 class="mt-2 text-2xl font-medium tracking-tight text-gray-900 md:text-3xl"><%= @tag_label %></h1>
    <% if @tag_description.present? %>
      <p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-600"><%= @tag_description %></p>
    <% end %>
  </header>

  <div class="mt-8">
    <%= render "galleries/main_photo_frame" %>
  </div>
</div>
