<%# locals: (contacts:, variant: :default) %>
<% return if contacts.blank? %>

<div class="<%= variant == :footer ? 'mt-3 flex flex-wrap gap-2' : 'mt-8 flex flex-wrap justify-center gap-4' %>">
  <% contacts.each do |contact| %>
    <%= link_to contact.url,
                target: "_blank",
                rel: "noopener noreferrer",
                class: "#{variant == :footer ? 'inline-flex h-9 w-9 items-center justify-center rounded-md border border-gray-200 bg-white text-brand shadow-sm transition hover:border-brand hover:shadow' : 'inline-flex flex-col items-center gap-2 rounded-xl border border-gray-200 bg-white px-5 py-4 shadow-sm transition hover:border-brand hover:shadow-md'}",
                title: contact.name do %>
      <% if contact.icon.attached? %>
        <%= image_tag contact.icon, alt: contact.name, class: "#{variant == :footer ? 'h-5 w-5' : 'h-8 w-8'} object-contain" %>
      <% elsif variant == :footer %>
        <span class="text-xs font-semibold"><%= contact.name.first %></span>
      <% end %>
      <% unless variant == :footer %>
        <span class="text-sm font-medium text-gray-900">
          <% if contact.username.present? %>
            @<%= contact.username %>
          <% else %>
            <%= contact.name %>
          <% end %>
        </span>
      <% end %>
    <% end %>
  <% end %>
</div>
