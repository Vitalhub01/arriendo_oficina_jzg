<article class="shop-product-card group">
  <%= link_to space_path(space), class: "block" do %>
    <div class="shop-product-card__media">
      <% if space.cover_photo %>
        <%= image_tag space.cover_photo.variant(resize_to_limit: [800, 1000]), alt: space.title %>
      <% else %>
        <div class="flex h-full items-center justify-center text-sm text-gray-400">Sin foto</div>
      <% end %>
      <span class="absolute bottom-3 left-3 bg-white/95 px-2.5 py-1 text-xs font-medium uppercase tracking-wide text-brand">
        <%= space.box_type_label %>
      </span>
    </div>
    <div class="shop-product-card__body">
      <h3 class="shop-product-card__title"><%= space.title %></h3>
      <p class="mt-1 text-sm text-gray-500"><%= space.commune %>, <%= space.city %></p>
      <p class="shop-product-card__price">
        <span class="font-medium text-gray-900"><%= format_clp(space.price_per_hour_cents) %></span> / hora
      </p>
    </div>
  <% end %>
</article>
