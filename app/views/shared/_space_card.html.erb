<div class="card group overflow-hidden">
  <%= link_to space_path(space), class: "block" do %>
    <div class="aspect-[4/3] overflow-hidden bg-gray-100">
      <% if space.cover_photo %>
        <%= image_tag space.cover_photo.variant(resize_to_limit: [800, 600]), class: "h-full w-full object-cover transition group-hover:scale-105", alt: space.title %>
      <% else %>
        <div class="flex h-full items-center justify-center text-gray-400">Sin foto</div>
      <% end %>
    </div>
    <div class="p-4">
      <div class="flex items-start justify-between gap-2">
        <h3 class="font-semibold text-gray-900 line-clamp-1"><%= space.title %></h3>
        <span class="shrink-0 rounded-full bg-rose-50 px-2 py-1 text-xs text-rose-700"><%= space.box_type_label %></span>
      </div>
      <p class="mt-1 text-sm text-gray-500"><%= space.commune %>, <%= space.city %></p>
      <p class="mt-2 text-sm">
        <span class="font-semibold"><%= format_clp(space.price_per_hour_cents) %></span>
        <span class="text-gray-500">/ hora</span>
      </p>
    </div>
  <% end %>
  <div class="border-t border-gray-100 px-4 pb-4">
    <%= link_to "Ver disponibilidad", space_path(space), class: "text-sm font-medium text-rose-600 hover:underline" %>
  </div>
</div>
