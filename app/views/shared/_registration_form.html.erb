<% resource ||= User.new %>
<% resource_name ||= :user %>
<%= form_for(resource, as: resource_name, url: registration_path(resource_name), html: { class: local_assigns.fetch(:form_class, "mt-4 space-y-4") }) do |f| %>
  <%= render "devise/shared/error_messages", resource: resource %>
  <% if resource.professional_profile&.errors&.any? %>
    <div class="rounded-xl bg-red-50 p-3 text-sm text-red-800">
      <% resource.professional_profile.errors.full_messages.each do |msg| %>
        <p><%= msg %></p>
      <% end %>
    </div>
  <% end %>
  <div>
    <%= f.label :name, "Nombre completo", class: "block text-sm font-medium" %>
    <%= f.text_field :name, class: "input-field", required: true, autocomplete: "name" %>
  </div>
  <div>
    <%= label_tag :user_rut, "RUT", class: "block text-sm font-medium" %>
    <%= text_field_tag "user[rut]", params.dig(:user, :rut), class: "input-field", placeholder: "12.345.678-9", required: true, autocomplete: "off" %>
  </div>
  <div>
    <%= f.label :email, class: "block text-sm font-medium" %>
    <%= f.email_field :email, class: "input-field", required: true, autocomplete: "email" %>
  </div>
  <div>
    <%= f.label :password, class: "block text-sm font-medium" %>
    <%= f.password_field :password, class: "input-field", required: true, autocomplete: "new-password" %>
  </div>
  <div>
    <%= f.label :password_confirmation, class: "block text-sm font-medium" %>
    <%= f.password_field :password_confirmation, class: "input-field", required: true, autocomplete: "new-password" %>
  </div>
  <%= f.submit local_assigns.fetch(:submit_label, "Registrarse"), class: "btn-primary w-full" %>
<% end %>
