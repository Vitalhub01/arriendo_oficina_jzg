<footer class="border-t border-gray-200 bg-gray-50">
  <div class="mx-auto max-w-7xl px-4 py-12 md:py-14">
    <div class="site-footer__main">
      <div class="site-footer__brand">
        <div class="logo-badge logo-badge--footer">
          <%= image_tag site_logo, alt: "VitalHub — Espacios de salud", **image_loading_attrs(eager: false) %>
        </div>
        <p class="mt-3 text-xs leading-relaxed text-gray-600 lg:text-[0.8125rem]">
          <%= site_nav_text('footer_tagline') %>
        </p>
      </div>

      <div class="site-footer__columns">
        <div>
          <p class="site-footer__column-title"><%= site_nav_text('footer_nav_heading') %></p>
          <ul class="mt-3 space-y-2 text-sm text-gray-600">
            <li><%= link_to site_nav_text('footer_link_spaces'), spaces_path, class: "hover:text-brand" %></li>
            <% if memberships_enabled? %>
              <li><%= link_to site_nav_text('footer_link_membership'), membership_path, class: "hover:text-brand" %></li>
            <% end %>
            <li><%= link_to site_nav_text('footer_link_terms'), terms_path, class: "hover:text-brand" %></li>
            <li><%= link_to site_nav_text('footer_link_privacy'), privacy_path, class: "hover:text-brand" %></li>
            <li><%= link_to site_nav_text('footer_link_cancellation'), cancellation_policy_path, class: "hover:text-brand" %></li>
          </ul>
        </div>

        <div>
          <p class="site-footer__column-title"><%= site_nav_text('footer_contact_heading') %></p>
          <div class="mt-3 space-y-2 text-sm">
            <% contact_email = site_nav_text('footer_contact_email') %>
            <% contact_phone = site_nav_text('footer_contact_phone') %>
            <%= mail_to contact_email, contact_email, class: "block break-all text-brand hover:underline" %>
            <%= link_to contact_phone,
                        whatsapp_url_for_phone(contact_phone),
                        target: "_blank",
                        rel: "noopener noreferrer",
                        class: "block text-brand hover:underline" %>
          </div>
        </div>

        <div>
          <p class="site-footer__column-title"><%= site_nav_text('footer_address_heading') %></p>
          <p class="mt-3 text-sm leading-snug text-gray-600"><%= site_nav_text('footer_address') %></p>
        </div>

        <div>
          <p class="site-footer__column-title"><%= site_nav_text('footer_hours_heading') %></p>
          <div class="mt-3 space-y-1 text-sm leading-snug text-gray-600">
            <p><%= site_nav_text('footer_hours_weekdays') %></p>
            <p><%= site_nav_text('footer_hours_saturday') %></p>
          </div>
        </div>

        <div>
          <p class="site-footer__column-title"><%= site_nav_text('footer_social_heading') %></p>
          <%= render "shared/social_contacts", contacts: footer_social_contacts, variant: :footer %>
        </div>
      </div>
    </div>

    <p class="mt-10 border-t border-gray-200/80 pt-6 text-center text-sm text-gray-400">
      &copy; <%= Date.current.year %> <%= site_nav_text('footer_copyright') %>
    </p>
  </div>
</footer>
