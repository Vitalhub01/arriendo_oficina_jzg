<footer class="border-t border-gray-200 bg-white">
  <div class="mx-auto max-w-7xl px-4 py-16">
    <div class="grid grid-cols-1 gap-12 md:grid-cols-3">
      <div>
        <div class="logo-badge logo-badge--footer">
          <%= image_tag site_logo, alt: "VitalHub — Espacios de salud" %>
        </div>
        <p class="mt-4 max-w-xs text-sm leading-relaxed text-gray-600">
          <%= site_nav_text('footer_tagline') %>
        </p>
      </div>

      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-gray-900"><%= site_nav_text('footer_nav_heading') %></p>
        <ul class="mt-4 space-y-3 text-sm text-gray-600">
          <li><%= link_to site_nav_text('footer_link_spaces'), spaces_path, class: "hover:text-brand" %></li>
          <li><%= link_to site_nav_text('footer_link_membership'), membership_path, class: "hover:text-brand" %></li>
          <li><%= link_to site_nav_text('footer_link_terms'), terms_path, class: "hover:text-brand" %></li>
          <li><%= link_to site_nav_text('footer_link_privacy'), privacy_path, class: "hover:text-brand" %></li>
          <li><%= link_to site_nav_text('footer_link_cancellation'), cancellation_policy_path, class: "hover:text-brand" %></li>
        </ul>
      </div>

      <div>
        <p class="text-xs font-medium uppercase tracking-widest text-gray-900"><%= site_nav_text('footer_contact_heading') %></p>
        <p class="mt-4 text-sm text-gray-600"><%= site_nav_text('footer_contact_line') %></p>
        <%= render "shared/social_contacts", contacts: footer_social_contacts, variant: :footer %>
        <p class="mt-4 text-sm text-gray-400">&copy; <%= Date.current.year %> <%= site_nav_text('footer_copyright') %></p>
      </div>
    </div>
  </div>
</footer>
