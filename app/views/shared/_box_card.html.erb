<%= link_to box_path(box), class: "card group block" do %>
  <div class="aspect-[4/3] overflow-hidden bg-gray-100">
    <% if box.cover_photo %>
      <%= image_tag box.cover_photo.variant(resize_to_limit: [800, 600]), class: "h-full w-full object-cover transition group-hover:scale-105", alt: box.title %>
    <% else %>
      <div class="flex h-full items-center justify-center text-gray-400">Sin foto</div>
    <% end %>
  </div>
  <div class="p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold text-gray-900 line-clamp-1"><%= box.title %></h3>
      <span class="shrink-0 text-xs rounded-full bg-rose-50 px-2 py-1 text-rose-700"><%= box.box_type_label %></span>
    </div>
    <p class="mt-1 text-sm text-gray-500"><%= box.commune %>, <%= box.city %></p>
    <p class="mt-2 text-sm">
      <span class="font-semibold"><%= format_clp(box.price_per_hour_cents) %></span>
      <span class="text-gray-500">/ hora</span>
    </p>
  </div>
<% end %>
