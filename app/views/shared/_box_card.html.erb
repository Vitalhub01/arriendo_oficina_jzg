<%= link_to box_path(box), class: "card group block" do %>
  <div class="aspect-[4/3] overflow-hidden bg-gray-100">
    <% if box.cover_photo %>
      <%= lazy_variant_image box.cover_photo,
          alt: box.title,
          resize_to_limit: [800, 600],
          img_class: "h-full w-full object-cover transition group-hover:scale-105",
          aspect_class: "aspect-[4/3] h-full" %>
    <% else %>
      <div class="flex h-full items-center justify-center text-gray-400">Sin foto</div>
    <% end %>
  </div>
  <div class="p-4">
    <div class="flex items-start justify-between gap-2">
      <h3 class="font-semibold text-gray-900 line-clamp-1"><%= box.title %></h3>
      <span class="shrink-0 text-xs rounded-full bg-brand-pale px-2 py-1 text-brand"><%= box.box_type_label %></span>
    </div>
    <p class="mt-1 text-sm text-gray-500"><%= box.commune %>, <%= box.city %></p>
    <div class="mt-2 text-sm text-gray-600">
      <%= render "shared/space_pricing_summary", space: box %>
    </div>
  </div>
<% end %>
