<%# locals: space, compact: false %>
<% compact = local_assigns.fetch(:compact, false) %>
<div class="<%= compact ? 'space-y-0.5 text-xs leading-snug text-gray-600' : 'shop-product-card__pricing' %>">
  <%= render "shared/pricing_period_cycle",
             morning_cents: space.morning_hourly_price_cents,
             afternoon_cents: space.afternoon_hourly_price_cents,
             fallback_cents: space.price_per_hour_cents,
             unit: "hora" %>
  <% unless compact %>
    <%= render "shared/pricing_period_cycle",
               morning_cents: space.morning_block_price_cents,
               afternoon_cents: space.afternoon_block_price_cents,
               unit: "bloque" %>
    <% if (jornada_cents = space.primary_jornada_definition&.price_cents) %>
      <p>
        <span class="font-medium text-gray-900"><%= format_clp(jornada_cents) %></span>
        <span>/ jornada</span>
      </p>
    <% end %>
  <% end %>
</div>
