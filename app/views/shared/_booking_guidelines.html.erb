<%# locals: (variant: :welcome) %>
<% variant = local_assigns.fetch(:variant, :welcome) %>

<% if variant == :reference %>
  <details class="group rounded-xl border border-gray-200 bg-white shadow-sm">
    <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-3 text-sm font-medium text-gray-900 [&::-webkit-details-marker]:hidden">
      <span class="flex items-center gap-2">
        <svg class="h-5 w-5 shrink-0 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
        </svg>
        Información útil sobre tus reservas
      </span>
      <span class="text-brand transition group-open:rotate-45" aria-hidden="true">+</span>
    </summary>
    <div class="border-t border-gray-100 px-4 py-4">
      <%= render "shared/booking_guidelines_body" %>
    </div>
  </details>
<% else %>
  <aside class="rounded-xl border border-brand/20 bg-brand-pale/40 px-4 py-4 sm:px-5 sm:py-5" role="status" aria-labelledby="booking-guidelines-heading">
    <div class="flex gap-3">
      <svg class="mt-0.5 h-5 w-5 shrink-0 text-brand" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
      </svg>
      <div class="min-w-0 flex-1">
        <h2 id="booking-guidelines-heading" class="text-base font-semibold text-gray-900">
          <%= variant == :welcome ? "Tu reserva está registrada" : "Información sobre tus reservas" %>
        </h2>
        <div class="mt-3">
          <%= render "shared/booking_guidelines_body" %>
        </div>
      </div>
    </div>
  </aside>
<% end %>
