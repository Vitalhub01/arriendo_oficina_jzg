<%# locals: morning_cents:, afternoon_cents:, unit:, fallback_cents: nil %>
<% fallback = local_assigns[:fallback_cents]
   morning = morning_cents.presence || fallback
   afternoon = afternoon_cents.presence || fallback
   period_prices = []
   period_prices << { label: 'mañana', amount: format_clp(morning) } if morning.present?
   period_prices << { label: 'tarde', amount: format_clp(afternoon) } if afternoon.present?
   period_prices.uniq! { |item| [item[:label], item[:amount]] } %>
<div class="flex flex-wrap items-baseline gap-x-2 text-4xl font-medium tracking-tight text-gray-900">
  <% if period_prices.any? %>
    <span class="text-base font-normal text-gray-500">Desde</span>
    <%= render "shared/pricing_period_cycle",
               morning_cents: morning,
               afternoon_cents: afternoon,
               unit: unit,
               fallback_cents: nil,
               amount_class: "transition-all duration-300 ease-out",
               unit_class: "text-base font-normal text-gray-500",
               segment_class: "price-period-segment--hero [&_[data-price-cycle-target=option]]:px-3 [&_[data-price-cycle-target=option]]:py-1 [&_[data-price-cycle-target=option]]:uppercase [&_[data-price-cycle-target=option]]:tracking-widest" %>
  <% else %>
    <span class="text-2xl">Consultar</span>
  <% end %>
</div>
