<!DOCTYPE html>
<html lang="es">
  <head>
    <title>Admin — VitalHub</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <link rel="icon" type="image/png" href="<%= asset_path('logo_vital_hub.png') %>">
  </head>
  <body class="min-h-screen bg-gray-100">
    <div class="flex min-h-screen">
      <aside class="hidden w-64 bg-gray-900 p-6 text-white md:block">
        <%= image_tag "logo_vital_hub.png", alt: "VitalHub", class: "h-9 w-auto" %>
        <nav class="mt-8 space-y-1">
          <% admin_nav_items.each do |item| %>
            <% if item[:children] %>
              <% section_active = admin_nav_active?(item[:match]) %>
              <p class="<%= admin_nav_section_label_classes(section_active) %>"><%= item[:label] %></p>
              <div class="mb-2 space-y-0.5">
                <% item[:children].each do |child| %>
                  <% child_active = admin_nav_active?(child[:match]) %>
                  <%= link_to child[:label], public_send(child[:path]), class: admin_nav_link_classes(child_active, nested: true) %>
                <% end %>
              </div>
            <% else %>
              <% active = admin_nav_active?(item[:match]) %>
              <%= link_to item[:label], public_send(item[:path]), class: admin_nav_link_classes(active) %>
            <% end %>
          <% end %>
          <%= link_to "Ver sitio", root_path, class: "mt-2 block rounded-lg px-3 py-2 text-sm text-white/70 transition hover:bg-gray-800 hover:text-white" %>
        </nav>
      </aside>
      <main class="flex-1 p-4 md:p-8">
        <%= render "shared/flash_messages" %>
        <%= yield %>
      </main>
    </div>
  </body>
</html>
