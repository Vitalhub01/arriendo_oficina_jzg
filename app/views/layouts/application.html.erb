<!DOCTYPE html>
<html lang="es"<% if ios_web_client? %> class="ios-ui-zoom-out"<% end %>>
  <head>
    <%= render "shared/seo" %>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <% if google_analytics_id.present? %>
      <script async src="https://www.googletagmanager.com/gtag/js?id=<%= google_analytics_id %>"></script>
      <script>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', '<%= google_analytics_id %>');
      </script>
    <% end %>
  </head>
  <% mobile_bottom_pad =
       if @minimal_chrome.present?
         ''
       elsif content_for?(:mobile_page_dock)
         'pb-32 md:pb-0'
       else
         'pb-16 md:pb-0'
       end %>
  <body class="min-h-screen bg-white<%= ' gallery-view' if @minimal_chrome.present? %> <%= mobile_bottom_pad %><%= " #{content_for(:body_class)}" if content_for?(:body_class) %>">
    <%= render "shared/navbar", compact: @minimal_chrome.present? %>
    <% if notice.present? || alert.present? %>
      <div class="mx-auto max-w-7xl px-4 py-3">
        <%= render "shared/flash_messages" %>
      </div>
    <% end %>
    <%= flash[:ga_event_script].html_safe if flash[:ga_event_script].present? %>
    <%= yield %>
    <% unless @minimal_chrome.present? %>
      <%= render "shared/mobile_tab_bar" %>
      <%= render "shared/footer" %>
    <% end %>
  </body>
</html>
