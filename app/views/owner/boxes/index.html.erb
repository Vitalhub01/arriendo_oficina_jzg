<div class="flex items-center justify-between">
  <h1 class="text-2xl font-bold">Mis boxes</h1>
  <%= link_to "Nuevo box", new_owner_box_path, class: "btn-primary" %>
</div>

<div class="mt-6 grid gap-4">
  <% @boxes.each do |box| %>
    <div class="card p-4 flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4">
      <div>
        <h3 class="font-semibold"><%= box.title %></h3>
        <p class="text-sm text-gray-500"><%= box.full_address %> · <%= box.status.humanize %></p>
      </div>
      <div class="flex flex-wrap gap-2">
        <%= link_to "Ver", owner_box_path(box), class: "btn-secondary !py-2 !px-3 text-sm" %>
        <%= link_to "Horarios", owner_box_availability_rules_path(box), class: "btn-secondary !py-2 !px-3 text-sm" %>
        <%= link_to "Editar", edit_owner_box_path(box), class: "btn-secondary !py-2 !px-3 text-sm" %>
        <% if box.draft? %>
          <%= button_to "Publicar", publish_owner_box_path(box), method: :patch, class: "btn-primary !py-2 !px-3 text-sm" %>
        <% end %>
      </div>
    </div>
  <% end %>
</div>
