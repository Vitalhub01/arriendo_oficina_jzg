<% content_for :title, "Espacios para arriendo | VitalHub" %>
<% content_for :meta_description, "Explora espacios disponibles para arriendo por bloques flexibles o día completo. VitalHub conecta profesionales de la salud con espacios equipados en Chile." %>

<section class="shop-section">
  <div class="mx-auto max-w-2xl text-center">
    <p class="shop-eyebrow">Catálogo</p>
    <h1 class="mt-2 text-3xl font-medium tracking-tight text-gray-900 md:text-4xl">Espacios para arriendo</h1>
    <p class="mt-4 text-gray-600">
      Encuentra arriendo de espacio profesional para consultas, terapias y atención de salud.
      Reserva bloques flexibles o el día completo según tu disponibilidad.
    </p>
  </div>

  <% if @spaces.any? %>
    <div class="mt-14 grid grid-cols-1 gap-x-6 gap-y-12 sm:grid-cols-2 lg:grid-cols-3">
      <% @spaces.each_with_index do |space, index| %>
        <%= render "shared/space_card", space: space, eager_image: index < 3 %>
      <% end %>
    </div>
  <% elsif @filtered_by_availability %>
    <div class="mx-auto mt-14 max-w-lg rounded-2xl border border-amber-200 bg-amber-50 p-6 text-center text-amber-950">
      <p class="font-medium">Ningún espacio coincide con esa fecha y horario.</p>
      <p class="mt-2 text-sm text-amber-900/90">Prueba un día entre lunes y viernes, en horario de agenda, o revisa el catálogo completo.</p>
      <%= link_to "Ver todos los espacios", spaces_path, class: "btn-primary mt-6 inline-flex" %>
    </div>
  <% else %>
    <div class="mx-auto mt-14 max-w-lg rounded-2xl border border-gray-200 bg-gray-50 p-6 text-center text-gray-700">
      <p class="font-medium">Aún no hay espacios publicados.</p>
      <p class="mt-2 text-sm">Cuando el administrador publique espacios, aparecerán aquí.</p>
    </div>
  <% end %>
</section>
