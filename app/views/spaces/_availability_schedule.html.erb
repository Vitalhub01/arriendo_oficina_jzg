<% interactive = local_assigns.fetch(:interactive, false) %>
<div class="mt-4">
  <div class="flex items-center justify-between">
    <% prev_week = week_start - 1.week %>
    <% next_week = week_start + 1.week %>
    <%= link_to "← Semana anterior", availability_space_path(space, week_start: prev_week), class: "text-sm font-medium text-rose-600 hover:underline", data: { turbo_frame: "availability_schedule" } %>
    <span class="text-sm text-gray-600"><%= l(week_start, format: :short) %> — <%= l(week_start + 6.days, format: :short) %></span>
    <%= link_to "Semana siguiente →", availability_space_path(space, week_start: next_week), class: "text-sm font-medium text-rose-600 hover:underline", data: { turbo_frame: "availability_schedule" } %>
  </div>

  <div class="mt-4 overflow-x-auto">
    <div class="grid min-w-[640px] grid-cols-7 gap-2">
      <% schedule.each do |day| %>
        <div class="rounded-xl border border-gray-200 p-2">
          <p class="text-center text-xs font-semibold text-gray-700"><%= day[:day_name][0..2] %></p>
          <p class="text-center text-[10px] text-gray-400"><%= l(day[:date], format: "%d/%m") %></p>
          <div class="mt-2 space-y-1">
            <% if day[:slots].any? %>
              <% day[:slots].each do |slot| %>
                <% slot_start_label = l(slot.starts_at, format: '%H:%M') %>
                <% slot_end_label = l(slot.ends_at, format: '%H:%M') %>
                <% if interactive && slot.available %>
                  <button type="button"
                          data-action="click->booking-form#selectSlot"
                          data-date="<%= day[:date].iso8601 %>"
                          data-start-time="<%= slot_start_label %>"
                          class="w-full cursor-pointer rounded px-1 py-0.5 text-center text-[10px] transition bg-green-100 text-green-800 hover:bg-green-200 hover:ring-2 hover:ring-green-400 focus:outline-none focus:ring-2 focus:ring-green-500">
                    <%= slot_start_label %>–<%= slot_end_label %>
                  </button>
                <% elsif interactive %>
                  <div class="rounded px-1 py-0.5 text-center text-[10px] bg-gray-100 text-gray-400 line-through">
                    <%= slot_start_label %>–<%= slot_end_label %>
                  </div>
                <% else %>
                  <div class="rounded px-1 py-0.5 text-center text-[10px] <%= slot.available ? 'bg-green-100 text-green-800' : 'bg-gray-100 text-gray-400 line-through' %>">
                    <%= slot_start_label %>–<%= slot_end_label %>
                  </div>
                <% end %>
              <% end %>
            <% else %>
              <p class="text-center text-[10px] text-gray-300">—</p>
            <% end %>
          </div>
        </div>
      <% end %>
    </div>
  </div>
  <% if interactive %>
    <p class="mt-3 text-xs text-gray-500">Haz clic en un bloque disponible para elegir fecha y hora en el formulario de reserva.</p>
  <% end %>
</div>
