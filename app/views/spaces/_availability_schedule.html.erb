<% interactive = local_assigns.fetch(:interactive, false) %>
<% schedule_week_entries = local_assigns.fetch(:schedule_week_entries, []) %>
<div class="relative mt-4">
  <div data-availability-schedule-target="loading" class="hidden absolute inset-0 z-10 flex items-center justify-center rounded-xl bg-white/70">
    <p class="text-sm font-medium text-gray-600">Cargando horarios…</p>
  </div>
  <div data-availability-schedule-target="content">
    <%= render "spaces/availability_schedule_week",
          space: space,
          schedule: schedule,
          week_start: week_start,
          interactive: interactive %>
  </div>
  <% schedule_week_entries.each do |entry| %>
    <% next if entry[:week_start] == week_start %>
    <template data-week-start="<%= entry[:week_start].iso8601 %>">
      <%= render "spaces/availability_schedule_week",
            space: space,
            schedule: entry[:schedule],
            week_start: entry[:week_start],
            interactive: interactive %>
    </template>
  <% end %>
</div>
<% if interactive %>
  <p class="mt-3 text-xs text-gray-500">Haz clic en una franja disponible para elegir fecha y bloque (mañana / tarde) en el formulario de reserva.</p>
<% end %>
