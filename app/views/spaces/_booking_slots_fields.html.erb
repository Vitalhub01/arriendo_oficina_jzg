<div>
  <%= label_tag :slot_count, "Cantidad de bloques", class: "mb-1 block text-sm font-medium" %>
  <div class="flex items-center gap-3">
    <button type="button" data-action="click->booking-form#decrement" class="flex h-11 w-11 items-center justify-center rounded-xl border border-gray-300 text-xl">−</button>
    <%= number_field_tag :slot_count, @prefill_slot_count || space.minimum_slots, min: space.minimum_slots, class: "input-field text-center", data: { booking_form_target: "slotCount", action: "input->booking-form#updateTotal" } %>
    <button type="button" data-action="click->booking-form#increment" class="flex h-11 w-11 items-center justify-center rounded-xl border border-gray-300 text-xl">+</button>
  </div>
  <p class="mt-1 text-xs text-gray-500" data-booking-form-target="durationLabel"></p>
</div>

<div class="rounded-xl bg-gray-50 p-4">
  <p class="text-sm text-gray-600">Total estimado</p>
  <p class="text-xl font-bold" data-booking-form-target="total"><%= format_clp(space.default_price_per_slot_cents * space.minimum_slots) %></p>
</div>
