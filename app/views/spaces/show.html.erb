<% content_for :title, "#{@space.title} — Arriendo de espacio | VitalHub" %>
<% content_for :meta_description, truncate_description(@space.description) %>
<% content_for :og_type, "product" %>
<% content_for :og_image, url_for(@space.cover_photo) if @space.photos_attached? %>
<% content_for :json_ld, space_offer_json_ld(@space) %>
<% content_for :body_class, "pb-24 lg:pb-0" %>
<% booking_interactive = user_signed_in? && current_user.can_book? %>
<% login_prompt_on_slots = !user_signed_in? %>
<% if booking_interactive %>
  <div data-controller="booking-form"
       data-booking-form-minimum-slots-value="<%= @space.minimum_slots %>"
       data-booking-form-blocks-by-day-value="<%= space_booking_blocks_by_day(@space).to_json %>"
       data-booking-form-overrides-value="<%= space_booking_block_overrides(@space).to_json %>"
       data-booking-form-today-value="<%= Date.current.iso8601 %>"
       data-booking-form-now-time-value="<%= Time.zone.now.strftime('%H:%M') %>"
       data-booking-form-slot-rates-value="<%= space_booking_slot_rates_payload(@space).to_json %>"
       data-booking-form-jornada-value="<%= space_booking_jornada_payload(@space).to_json %>"
       data-booking-form-reserved-intervals-value="<%= space_booking_reserved_intervals(@space).to_json %>">
<% end %>
<div class="mx-auto max-w-7xl px-4 py-6">
  <% if @errors.present? %>
    <div class="mb-4 rounded-xl bg-red-50 p-4 text-red-800">
      <ul class="list-disc pl-5"><% @errors.each do |e| %><li><%= e %></li><% end %></ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
    <div class="space-y-8 lg:col-span-2">
      <div class="overflow-hidden rounded-2xl">
        <%= render "shared/place_cover_photo", record: @space, title: @space.title %>
      </div>

      <div>
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <h1 class="text-2xl font-bold md:text-3xl"><%= @space.title %></h1>
            <p class="mt-1 text-gray-600"><%= @space.commune %>, <%= @space.city %></p>
          </div>
          <span class="rounded-full bg-brand-pale px-3 py-1 text-sm font-medium text-brand"><%= @space.box_type_label %></span>
        </div>
        <p class="mt-4 leading-relaxed text-gray-700"><%= simple_format(@space.description) %></p>

        <% if equipment_list(@space).any? %>
          <h2 class="mt-6 text-lg font-semibold">Implementos</h2>
          <ul class="mt-2 list-disc pl-5 text-gray-700">
            <% equipment_list(@space).each do |item| %>
              <li><%= item %></li>
            <% end %>
          </ul>
        <% end %>

        <% if @space.amenity_tags.any? %>
          <h2 class="mt-6 text-lg font-semibold">Comodidades y servicios</h2>
          <div class="mt-2 flex flex-wrap gap-2">
            <% @space.amenity_tags.ordered.each do |tag| %>
              <span class="rounded-full bg-gray-100 px-3 py-1 text-sm text-gray-700"><%= tag.name %></span>
            <% end %>
          </div>
        <% end %>
      </div>

      <section>
        <h2 class="text-xl font-semibold">Horarios disponibles</h2>
        <%= turbo_frame_tag "availability_schedule",
              data: {
                controller: "availability-schedule",
                availability_schedule_loading_class: "opacity-50 pointer-events-none"
              } do %>
          <%= render "spaces/availability_schedule",
                space: @space,
                schedule: @schedule,
                week_start: @week_start,
                interactive: booking_interactive,
                login_prompt_on_slots: login_prompt_on_slots,
                schedule_week_entries: @schedule_week_entries %>
        <% end %>
      </section>
    </div>

    <div id="space-booking-panel"
         class="fixed inset-0 z-50 hidden overflow-y-auto bg-white p-4 lg:static lg:z-auto lg:block lg:overflow-visible lg:bg-transparent lg:p-0">
      <div class="mb-4 flex items-center justify-between lg:hidden">
        <h2 class="text-lg font-semibold">Reservar</h2>
        <button type="button" data-action="booking-form#closePanel" class="text-2xl leading-none" aria-label="Cerrar">&times;</button>
      </div>
      <div class="lg:sticky lg:top-24 lg:rounded-2xl lg:border lg:border-gray-200 lg:bg-white lg:p-6 lg:shadow-lg">
        <%= render "spaces/booking_form", space: @space %>
      </div>
    </div>
  </div>
</div>

<div class="fixed inset-x-0 bottom-0 z-40 border-t border-gray-200 bg-white p-4 shadow-lg lg:hidden">
  <div class="flex items-center justify-between gap-4">
    <div class="min-w-0">
      <%= render "shared/space_pricing_summary", space: @space, compact: true %>
    </div>
    <% if user_signed_in? %>
      <button type="button" class="btn-primary" data-action="booking-form#openPanel">Reservar</button>
    <% else %>
      <%= link_to "Reservar", checkout_space_path(@space), class: "btn-primary" %>
    <% end %>
  </div>
</div>
<% if booking_interactive %>
  </div>
<% end %>
