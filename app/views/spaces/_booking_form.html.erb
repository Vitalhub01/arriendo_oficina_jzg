<% blocks_by_day = space.schedule_blocks.ordered.group_by(&:day_of_week).transform_values do |blocks|
  blocks.map do |b|
    {
      id: b.id,
      start: b.start_time.strftime('%H:%M'),
      end: b.end_time.strftime('%H:%M'),
      price: b.price_cents,
      duration: b.duration_minutes
    }
  end
end %>
<% block_overrides = space.schedule_block_overrides.where('date >= ?', Date.current).map { |o|
  {
    schedule_block_id: o.schedule_block_id,
    date: o.date.iso8601,
    blocked: o.blocked,
    price: o.price_cents
  }
} %>
<div data-controller="booking-form"
     data-booking-form-minimum-slots-value="<%= space.minimum_slots %>"
     data-booking-form-blocks-by-day-value="<%= blocks_by_day.to_json %>"
     data-booking-form-overrides-value="<%= block_overrides.to_json %>">
  <p class="text-2xl font-bold text-gray-900">Reserva por bloques</p>
  <p class="mt-1 text-sm text-gray-500">Mínimo <%= space.minimum_slots %> bloque(s) contiguos según la agenda del espacio.</p>

  <% if user_signed_in? && current_user.can_book? %>
    <div class="mt-4">
      <%= form_with url: space_bookings_path(space), method: :post, local: true, class: "space-y-4" do %>
        <div>
          <%= label_tag :date, "Fecha", class: "mb-1 block text-sm font-medium" %>
          <%= date_field_tag :date, @prefill_date || Date.current, class: "input-field", required: true, data: { booking_form_target: "date", action: "change->booking-form#refreshStarts" } %>
        </div>
        <div>
          <%= label_tag :start_time, "Hora inicio", class: "mb-1 block text-sm font-medium" %>
          <%= select_tag :start_time, options_for_select([]), class: "input-field", required: true, data: { booking_form_target: "startTime", action: "change->booking-form#updateTotal" } %>
        </div>
        <%= render "spaces/booking_slots_fields", space: space %>
        <% if current_user.reschedule_credits.usable.any? %>
          <div>
            <%= label_tag :reschedule_credit_id, "Usar crédito de reagendamiento", class: "mb-1 block text-sm font-medium" %>
            <%= select_tag :reschedule_credit_id,
                  options_from_collection_for_select(current_user.reschedule_credits.usable, :id, ->(c) { "#{format_clp(c.amount_cents)} (#{c.hours}h)" }),
                  { include_blank: "No usar crédito" }, class: "input-field" %>
          </div>
        <% end %>
        <%= submit_tag "Reservar y pagar", class: "btn-primary w-full" %>
      <% end %>
    </div>
  <% elsif user_signed_in? %>
    <%= link_to "Completa tu perfil para reservar", onboarding_path, class: "btn-primary mt-4 block w-full text-center" %>
  <% else %>
    <%= link_to "Ingresa para reservar", new_user_session_path, class: "btn-primary mt-4 block w-full text-center" %>
  <% end %>
</div>
