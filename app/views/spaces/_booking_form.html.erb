<div data-controller="booking-form"
     data-booking-form-slot-duration-value="<%= space.slot_duration_minutes %>"
     data-booking-form-minimum-slots-value="<%= space.minimum_slots %>"
     data-booking-form-default-price-value="<%= space.default_price_per_slot_cents %>"
     data-booking-form-rates-value="<%= space.slot_rates.ordered.map { |r| { start: r.start_time.strftime('%H:%M'), end: r.end_time.strftime('%H:%M'), price: r.price_per_slot_cents } }.to_json %>">
  <p class="text-2xl font-bold"><%= format_clp(space.default_price_per_slot_cents) %> <span class="text-base font-normal text-gray-500">/ bloque (<%= space.slot_duration_minutes %> min)</span></p>
  <p class="mt-1 text-sm text-gray-500">Mínimo <%= space.minimum_slots %> bloque(s)</p>

  <% if space.slot_rates.any? %>
    <div class="mt-3 space-y-1 text-sm text-gray-600">
      <% space.slot_rates.ordered.each do |rate| %>
        <p><%= rate.name %>: <%= rate.start_time.strftime('%H:%M') %>–<%= rate.end_time.strftime('%H:%M') %> — <%= rate.formatted_price %>/bloque</p>
      <% end %>
    </div>
  <% end %>

  <% if user_signed_in? && current_user.can_book? %>
    <div class="mt-4">
      <%= form_with url: space_bookings_path(space), method: :post, local: true, class: "space-y-4" do %>
        <div>
          <%= label_tag :date, "Fecha", class: "mb-1 block text-sm font-medium" %>
          <%= date_field_tag :date, @prefill_date || Date.current, class: "input-field", required: true %>
        </div>
        <div>
          <%= label_tag :start_time, "Hora inicio", class: "mb-1 block text-sm font-medium" %>
          <%= time_field_tag :start_time, @prefill_start_time || "09:00", class: "input-field", required: true, data: { booking_form_target: "startTime", action: "change->booking-form#updateTotal input->booking-form#updateTotal" } %>
        </div>
        <%= render "spaces/booking_slots_fields", space: space %>
        <% if current_user.reschedule_credits.usable.any? %>
          <div>
            <%= label_tag :reschedule_credit_id, "Usar crédito de reagendamiento", class: "mb-1 block text-sm font-medium" %>
            <%= select_tag :reschedule_credit_id,
                  options_from_collection_for_select(current_user.reschedule_credits.usable, :id, ->(c) { "#{format_clp(c.amount_cents)} (#{c.hours}h)" }),
                  { include_blank: "No usar crédito" }, class: "input-field" %>
          </div>
        <% end %>
        <%= submit_tag "Reservar y pagar", class: "btn-primary w-full" %>
      <% end %>
    </div>
  <% elsif user_signed_in? %>
    <%= link_to "Completa tu perfil para reservar", onboarding_path, class: "btn-primary mt-4 block w-full text-center" %>
  <% else %>
    <%= link_to "Ingresa para reservar", new_user_session_path, class: "btn-primary mt-4 block w-full text-center" %>
  <% end %>
</div>
