# Credenciales de prueba: https://www.mercadopago.cl/developers/panel/app → credenciales de prueba
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_PUBLIC_KEY=
# true en local con credenciales de prueba (redirect a sandbox_init_point)
MERCADOPAGO_SANDBOX=
MERCADOPAGO_WEBHOOK_SECRET=
# Solo hostname (sin https://). Prod canónico: www.vitalhub.cl
# config.hosts en production también permite vitalhub.cl y arriendo-oficina-jzg.onrender.com
APP_HOST=localhost:3000
# URL pública HTTPS completa (túnel ngrok/cloudflared). Activa auto_return de Mercado Pago en local.
# APP_BASE_URL=https://tu-tunel.ngrok-free.app
# MERCADOPAGO_HTTPS_BACK_URLS=true
BOOKING_PAYMENT_TTL_MINUTES=30
RESCHEDULE_NOTICE_HOURS=24
# Required on Render (vitalhub-kv / Valkey). With REDIS_URL set, Docker entrypoint starts Sidekiq beside Puma (no separate worker service).
# Local: set SKIP_SIDEKIQ=1 if you run Sidekiq in another terminal or docker-compose sidekiq service.
REDIS_URL=redis://localhost:6379/0
# SKIP_SIDEKIQ=1
# local | test | supabase (prod en Render)
ACTIVE_STORAGE_SERVICE=local
# Supabase Storage (Settings → Storage → S3 access keys). Bucket público para lectura de fotos.
SUPABASE_PROJECT_REF=
SUPABASE_STORAGE_BUCKET=
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_REGION=us-east-1
# Opcional si el endpoint difiere del default por PROJECT_REF
# SUPABASE_STORAGE_ENDPOINT=https://YOUR_REF.storage.supabase.co/storage/v1/s3
SUPERSALUD_API_KEY=
SUPERSALUD_STUB=true
LIBREDTE_API_URL=https://libredte.cl/api
LIBREDTE_API_TOKEN=
LIBREDTE_EMISOR_RUT=
LIBREDTE_STUB=true
MAILER_FROM=noreply@jzg.cl
GOOGLE_ANALYTICS_ID=
DATABASE_USER=jzg
DATABASE_PASSWORD=jzg
DATABASE_NAME=jzg_development
# Host 5433 when another Postgres uses 5432 (see docker-compose db ports)
DATABASE_PORT=5433
